# Canonical NativeInterface callin inventory.
#
# CALLIN(name, query, result, environments, aggregation, flags)
# ALIAS(name, canonical-name)
#
# Environments are a pipe-separated subset of rules-synced, rules-unsynced,
# gaia-synced, gaia-unsynced and ui. UI dispatch is filtered by the native
# LuaUI visibility context before a Wasm module sees an object-bearing query.
# Aggregation is explicit because boolean and value callins do not share a
# universal fan-out rule.

ALIAS(AllowUnitCaptureStep, AllowUnitBuildStep)
ALIAS(AllowUnitTransportLoad, AllowUnitTransportPosition)
ALIAS(AllowUnitTransportUnload, AllowUnitTransportPosition)
ALIAS(CameraPositionChanged, Float3Callin)
ALIAS(CameraRotationChanged, Float3Callin)
ALIAS(DrawAlphaFeaturesLua, DrawAlphaObjectsLua)
ALIAS(DrawAlphaUnitsLua, DrawAlphaObjectsLua)
