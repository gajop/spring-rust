  }

  record unit-weapon-state {
    reload-time: f32,
    reload-frame: f32,
    range: f32,
    projectile-speed: f32,
    accuracy: f32,
    spray-angle: f32,
    aim-from-height: f32,
    salvo-size: f32,
    salvo-delay: f32,
    salvo-error: f32,
    target-move-error: f32,
    turn-rate: f32,
    auto-target: bool,
  }

  record unit-weapon-target {
