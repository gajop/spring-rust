interface vfs {
  record spring-error { code: s32 }

  record dir-entry {
    name: string,
    is-directory: bool,
  }

  record file-info {
    name: string,
    size: u32,
    mode: u32,
    is-directory: bool,
  }

  record get-file-info-value {
    info: file-info,
    exists: bool,
  }

  calculate-hash: func(data: list<u8>, hash-type: s32) -> result<string, spring-error>;
  file-exists: func(path: string) -> result<bool, spring-error>;
  get-file-info: func(path: string) -> result<get-file-info-value, spring-error>;
  get-file-size: func(path: string) -> result<u32, spring-error>;
  is-directory: func(path: string) -> result<bool, spring-error>;
  list-dir: func(path: string, pattern: string, mode: string, recursive: bool) -> result<list<dir-entry>, spring-error>;
  pack-f32: func(values: list<f32>) -> result<list<u8>, spring-error>;
  pack-s16: func(values: list<s16>) -> result<list<u8>, spring-error>;
  pack-s32: func(values: list<s32>) -> result<list<u8>, spring-error>;
  pack-s8: func(values: list<s8>) -> result<list<u8>, spring-error>;
  pack-u16: func(values: list<u16>) -> result<list<u8>, spring-error>;
  pack-u32: func(values: list<u32>) -> result<list<u8>, spring-error>;
  pack-u8: func(values: list<u8>) -> result<list<u8>, spring-error>;
  read-file: func(path: string) -> result<list<u8>, spring-error>;
  read-file-as-string: func(path: string) -> result<string, spring-error>;
  unpack-f32: func(data: list<u8>, byte-offset: u32, count: u32) -> result<list<f32>, spring-error>;
  unpack-s16: func(data: list<u8>, byte-offset: u32, count: u32) -> result<list<s16>, spring-error>;
  unpack-s32: func(data: list<u8>, byte-offset: u32, count: u32) -> result<list<s32>, spring-error>;
  unpack-s8: func(data: list<u8>, byte-offset: u32, count: u32) -> result<list<s8>, spring-error>;
  unpack-u16: func(data: list<u8>, byte-offset: u32, count: u32) -> result<list<u16>, spring-error>;
  unpack-u32: func(data: list<u8>, byte-offset: u32, count: u32) -> result<list<u32>, spring-error>;
  unpack-u8: func(data: list<u8>, byte-offset: u32, count: u32) -> result<list<u8>, spring-error>;
  zlib-compress: func(data: list<u8>) -> result<list<u8>, spring-error>;
  zlib-decompress: func(data: list<u8>) -> result<list<u8>, spring-error>;
}

