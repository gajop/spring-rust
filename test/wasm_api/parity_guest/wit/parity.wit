  record set-unit-leaves-ghost-options {
    leaves-ghost: bool,
    leave-dead-ghost: bool,
  }

  record set-unit-target-options {
    manual-fire: bool,
    user-target: bool,
  }

  record set-unit-use-weapons-options {
    force-use-weapons: bool,
    allow-use-weapons: bool,
  }

  record unit-cost-overrides {
    build-time: f32,
    metal-cost: f32,
    energy-cost: f32,
  }

  record unit-health-value {
    health: f32,
    capture: f32,
    paralyze: f32,
    build: f32,
    use-amounts: bool,
  }

  record unit-target-ref {
    target-id: s32,
    pos: float3,
    is-ground-target: bool,
  }

  add-unit-damage: func(unit-id: s32, damage: f32, paralyze-time: f32, weapon-def-id: s32, attacker-id: s32, impulse: float3) -> result<bool, spring-error>;
  add-unit-experience: func(unit-id: s32, experience: f32) -> result<bool, spring-error>;
  add-unit-impulse: func(unit-id: s32, impulse: float3, decay-rate: f32) -> result<bool, spring-error>;
  add-unit-resource: func(unit-id: s32, resource-type: string, amount: f32) -> result<bool, spring-error>;
  add-unit-seismic-ping: func(unit-id: s32, ping-size: f32) -> result<bool, spring-error>;
  bugger-off: func(pos: float3, radius: f32, team-id: s32, options: bugger-off-options, exclude-unit-def-i-ds: list<s32>) -> result<bool, spring-error>;
  clear-unit-goal: func(unit-id: s32, cancel-raw: bool) -> result<bool, spring-error>;
  create-unit: func(unit-def: def-ref, pos: float3, facing: s32, team-id: s32, options: create-unit-options) -> result<s32, spring-error>;
  destroy-unit: func(unit-id: s32, options: destroy-unit-options) -> result<bool, spring-error>;
  edit-unit-cmd-desc: func(unit-id: s32, cmd-desc-index: u32, cmd-desc: native-command-description) -> result<bool, spring-error>;
  force-unit-collision-update: func(unit-id: s32) -> result<bool, spring-error>;
  get-unit-feature-separation: func(unit-id: s32, feature-id: s32, ignore-y: bool) -> result<f32, spring-error>;
  get-unit-leaves-ghost: func(unit-id: s32) -> result<bool, spring-error>;
  get-unit-physical-state: func(unit-id: s32) -> result<u32, spring-error>;
  give-order-array-to-unit: func(unit-id: s32, commands: list<native-command>) -> result<bool, spring-error>;
  give-order-array-to-unit-array: func(unit-i-ds: list<s32>, commands: list<native-command>, pairwise: bool) -> result<s32, spring-error>;
  give-order-to-unit: func(unit-id: s32, cmd-id: s32, params: list<f32>, options: u32, timeout: s32) -> result<bool, spring-error>;
  insert-unit-cmd-desc: func(unit-id: s32, cmd-desc-index: s32, cmd-desc: native-command-description) -> result<bool, spring-error>;
  remove-unit-cmd-desc: func(unit-id: s32, cmd-desc-index: s32) -> result<bool, spring-error>;
  set-unit-always-visible: func(unit-id: s32, always-visible: bool) -> result<bool, spring-error>;
  set-unit-armored: func(unit-id: s32, armored-state: bool, armored-multiple: f32) -> result<bool, spring-error>;
  set-unit-blocking: func(unit-id: s32, options: set-unit-blocking-options) -> result<bool, spring-error>;
  set-unit-build-params: func(unit-id: s32, param-name: string, value: number-or-bool) -> result<bool, spring-error>;
  set-unit-build-speed: func(unit-id: s32, build-speed: f32, repair-speed: f32, reclaim-speed: f32, resurrect-speed: f32, capture-speed: f32, terraform-speed: f32) -> result<bool, spring-error>;
  set-unit-buildee-radius: func(unit-id: s32, radius: f32) -> result<bool, spring-error>;
  set-unit-cloak: func(unit-id: s32, cloak: number-or-bool, cloak-arg: number-or-bool) -> result<bool, spring-error>;
  set-unit-collision-volume-data: func(unit-id: s32, scales: float3, offsets: float3, volume-type: s32, test-type: s32, primary-axis: s32) -> result<bool, spring-error>;
  set-unit-costs: func(unit-id: s32, costs: unit-cost-overrides) -> result<bool, spring-error>;
  set-unit-crashing: func(unit-id: s32, want-crash: bool) -> result<bool, spring-error>;
  set-unit-direction: func(unit-id: s32, front-dir: float3, right-dir: float3) -> result<bool, spring-error>;
  set-unit-experience: func(unit-id: s32, experience: f32) -> result<bool, spring-error>;
  set-unit-flanking: func(unit-id: s32, %type: string, args: float3) -> result<bool, spring-error>;
  set-unit-harvest-storage: func(unit-id: s32, stored-metal: f32, max-stored-metal: f32, stored-energy: f32, max-stored-energy: f32) -> result<bool, spring-error>;
  set-unit-heading-and-up-dir: func(unit-id: s32, heading: s32, up-dir: float3) -> result<bool, spring-error>;
  set-unit-health: func(unit-id: s32, value: unit-health-value) -> result<bool, spring-error>;
  set-unit-land-goal: func(unit-id: s32, pos: float3, radius-sq: f32) -> result<bool, spring-error>;
  set-unit-leaves-ghost: func(unit-id: s32, options: set-unit-leaves-ghost-options) -> result<bool, spring-error>;
  set-unit-loading-transport: func(unit-id: s32, transport-id: s32) -> result<bool, spring-error>;
  set-unit-los-mask: func(unit-id: s32, ally-team-id: s32, los-mask: u8) -> result<bool, spring-error>;
  set-unit-los-state: func(unit-id: s32, ally-team-id: s32, los-state: u8) -> result<bool, spring-error>;
  set-unit-mass: func(unit-id: s32, mass: f32) -> result<bool, spring-error>;
  set-unit-max-health: func(unit-id: s32, max-health: f32) -> result<bool, spring-error>;
  set-unit-max-range: func(unit-id: s32, max-range: f32) -> result<bool, spring-error>;
  set-unit-metal-extraction: func(unit-id: s32, depth: f32, range: f32) -> result<bool, spring-error>;
  set-unit-mid-and-aim-pos: func(unit-id: s32, mid-pos: float3, aim-pos: float3, set-relative: bool) -> result<bool, spring-error>;
  set-unit-move-goal: func(unit-id: s32, pos: float3, radius: f32, speed: f32, raw: bool) -> result<bool, spring-error>;
  set-unit-nano-pieces: func(unit-id: s32, piece-indices: list<s32>) -> result<bool, spring-error>;
  set-unit-neutral: func(unit-id: s32, neutral: bool) -> result<bool, spring-error>;
  set-unit-physical-state-bit: func(unit-id: s32, state-bit: s32) -> result<bool, spring-error>;
  set-unit-physics: func(unit-id: s32, pos: float3, velocity: float3, rotation: float3, drag: float3) -> result<bool, spring-error>;
  set-unit-piece-collision-volume-data: func(unit-id: s32, piece-index: s32, enable: bool, scales: float3, offsets: float3, volume-type: s32, primary-axis: s32) -> result<bool, spring-error>;
  set-unit-piece-matrix: func(unit-id: s32, piece-index: s32, matrix: list<f32>) -> result<bool, spring-error>;
  set-unit-piece-parent: func(unit-id: s32, child-piece-index: s32, parent-piece-index: s32) -> result<bool, spring-error>;
  set-unit-piece-visible: func(unit-id: s32, piece-index: s32, visible: bool) -> result<bool, spring-error>;
  set-unit-pos-error-params: func(unit-id: s32, pos-error-vector: float3, pos-error-delta: float3, next-pos-error-update: s32, ally-team-id: s32, set-pos-error-bit: bool) -> result<bool, spring-error>;
  set-unit-position: func(unit-id: s32, pos: float3) -> result<bool, spring-error>;
  set-unit-radius-and-height: func(unit-id: s32, radius: f32, height: f32) -> result<bool, spring-error>;
  set-unit-resourcing: func(unit-id: s32, %type: string, amount: f32) -> result<bool, spring-error>;
  set-unit-rotation: func(unit-id: s32, rotation: float3) -> result<bool, spring-error>;
  set-unit-seismic-signature: func(unit-id: s32, seismic-signature: f32) -> result<bool, spring-error>;
  set-unit-sensor-radius: func(unit-id: s32, sensor-type: string, radius: s32) -> result<s32, spring-error>;
  set-unit-shield-recharge-delay: func(unit-id: s32, weapon-num: s32, recharge-delay: f32) -> result<bool, spring-error>;
  set-unit-shield-state: func(unit-id: s32, weapon-num: s32, enabled: bool, power: f32) -> result<bool, spring-error>;
  set-unit-sonar-stealth: func(unit-id: s32, sonar-stealth: bool) -> result<bool, spring-error>;
  set-unit-stealth: func(unit-id: s32, stealth: bool) -> result<bool, spring-error>;
  set-unit-stockpile: func(unit-id: s32, stockpile: s32, build-percent: f32) -> result<bool, spring-error>;
  set-unit-storage: func(unit-id: s32, %resource: string, amount: f32) -> result<bool, spring-error>;
  set-unit-target: func(unit-id: s32, target: unit-target-ref, options: set-unit-target-options, weapon-num: s32) -> result<bool, spring-error>;
  set-unit-tooltip: func(unit-id: s32, tooltip: string) -> result<bool, spring-error>;
  set-unit-use-air-los: func(unit-id: s32, use-air-los: bool) -> result<bool, spring-error>;
  set-unit-use-weapons: func(unit-id: s32, options: set-unit-use-weapons-options) -> result<bool, spring-error>;
  set-unit-velocity: func(unit-id: s32, velocity: float3) -> result<bool, spring-error>;
  set-unit-weapon-damages: func(unit-id: s32, weapon-num: s32, damage-key: string, damage-value: f32) -> result<bool, spring-error>;
  set-unit-weapon-state: func(unit-id: s32, weapon-num: s32, key: string, value: f32) -> result<bool, spring-error>;
  transfer-unit: func(unit-id: s32, new-team-id: s32, given: bool, adjust-unit-limit: bool) -> result<bool, spring-error>;
  unit-attach: func(transporter-id: s32, transportee-id: s32, piece-num: s32) -> result<bool, spring-error>;
  unit-detach: func(transportee-id: s32) -> result<bool, spring-error>;
