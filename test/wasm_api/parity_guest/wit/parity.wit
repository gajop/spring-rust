    weapon-aim-pos: float3,
    weapon-dir: float3,
  }

  get-unit-max-range: func(unit-id: s32) -> result<f32, spring-error>;
  get-unit-weapon-can-fire: func(unit-id: s32, weapon-num: s32) -> result<bool, spring-error>;
  get-unit-weapon-damages: func(unit-id: s32, weapon-num: s32) -> result<unit-weapon-damages, spring-error>;
  get-unit-weapon-have-free-line-of-fire: func(unit-id: s32, weapon-num: s32, target-id: s32, source-pos: float3, target-pos: float3, options: get-unit-weapon-have-free-line-of-fire-options) -> result<bool, spring-error>;
  get-unit-weapon-state: func(unit-id: s32, weapon-num: s32, key: string) -> result<unit-weapon-state, spring-error>;
  get-unit-weapon-target: func(unit-id: s32, weapon-num: s32) -> result<unit-weapon-target, spring-error>;
  get-unit-weapon-test-range: func(unit-id: s32, weapon-num: s32, target-pos: float3) -> result<bool, spring-error>;
  get-unit-weapon-test-target: func(unit-id: s32, weapon-num: s32, target-id: s32, target-pos: float3, options: get-unit-weapon-test-target-options) -> result<bool, spring-error>;
  get-unit-weapon-try-target: func(unit-id: s32, weapon-num: s32, target-id: s32, target-pos: float3, options: get-unit-weapon-try-target-options) -> result<bool, spring-error>;
  get-unit-weapon-vectors: func(unit-id: s32, weapon-num: s32) -> result<unit-weapon-vectors, spring-error>;
}

