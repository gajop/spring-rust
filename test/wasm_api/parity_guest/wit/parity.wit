  get-feature-piece-pos-dir: func(feature-id: s32, piece-num: s32) -> result<piece-pos-dir, spring-error>;
  get-feature-piece-position: func(feature-id: s32, piece-num: s32) -> result<float3, spring-error>;
  get-feature-root-piece: func(feature-id: s32) -> result<s32, spring-error>;
  get-model-piece-list: func(model-name: string) -> result<list<string>, spring-error>;
  get-model-piece-map: func(model-name: string) -> result<list<piece-map-entry>, spring-error>;
  get-model-root-piece: func(model-name: string) -> result<s32, spring-error>;
  get-unit-piece-direction: func(unit-id: s32, piece-num: s32) -> result<float3, spring-error>;
  get-unit-piece-info: func(unit-id: s32, piece-num: s32) -> result<get-unit-piece-info-value, spring-error>;
  get-unit-piece-list: func(unit-id: s32) -> result<list<string>, spring-error>;
  get-unit-piece-map: func(unit-id: s32) -> result<list<piece-map-entry>, spring-error>;
  get-unit-piece-matrix: func(unit-id: s32, piece-num: s32) -> result<piece-matrix, spring-error>;
  get-unit-piece-pos-dir: func(unit-id: s32, piece-num: s32) -> result<piece-pos-dir, spring-error>;
  get-unit-piece-position: func(unit-id: s32, piece-num: s32) -> result<float3, spring-error>;
  get-unit-root-piece: func(unit-id: s32) -> result<s32, spring-error>;
  get-unit-script-names: func(unit-id: s32) -> result<list<string>, spring-error>;
  get-unit-script-piece: func(unit-id: s32, script-num: s32) -> result<s32, spring-error>;
}

interface units-query {
  record spring-error { code: s32 }

  record float3 {
    x: f32,
    y: f32,
    z: f32,
  }

  record float4 {
    x: f32,
    y: f32,
    z: f32,
    w: f32,
  }

  record get-closest-enemy-unit-options {
    use-los: bool,
    sphere-dist-test: bool,
    check-sight-dist: bool,
  }

  record get-unit-nearest-enemy-options {
    use-los: bool,
    sphere-dist-test: bool,
    check-sight-dist: bool,
  }

  record get-unit-separation-options {
    positional: bool,
    check-map: bool,
  }

  record planes-query {
    planes: list<float4>,
    plane-count: u32,
  }

  record team-units-by-def {
    unit-def-id: s32,
    units: list<s32>,
  }

  record unit-def-count {
    unit-def-id: s32,
    count: u32,
  }

  get-all-units: func(unused: u8) -> result<list<s32>, spring-error>;
  get-closest-enemy-unit: func(pos: float3, range: f32, ally-team-id: s32, options: get-closest-enemy-unit-options) -> result<s32, spring-error>;
  get-team-unit-count: func(team-id: s32) -> result<u32, spring-error>;
  get-team-unit-def-count: func(team-id: s32, unit-def-id: s32) -> result<u32, spring-error>;
  get-team-units: func(team-id: s32) -> result<list<s32>, spring-error>;
  get-team-units-by-defs: func(team-id: s32, unit-def-i-ds: list<s32>) -> result<list<s32>, spring-error>;
  get-team-units-counts: func(team-id: s32) -> result<list<unit-def-count>, spring-error>;
  get-team-units-sorted: func(team-id: s32) -> result<list<team-units-by-def>, spring-error>;
  get-unit-array-centroid: func(unit-i-ds: list<s32>) -> result<float3, spring-error>;
  get-unit-map-centroid: func(unit-i-ds: list<s32>) -> result<float3, spring-error>;
  get-unit-nearest-ally: func(unit-id: s32, range: f32) -> result<s32, spring-error>;
  get-unit-nearest-enemy: func(unit-id: s32, range: f32, options: get-unit-nearest-enemy-options) -> result<s32, spring-error>;
  get-unit-separation: func(unit-id1: s32, unit-id2: s32, options: get-unit-separation-options) -> result<f32, spring-error>;
  get-units-in-box: func(xmin: f32, ymin: f32, zmin: f32, xmax: f32, ymax: f32, zmax: f32, allegiance: s32) -> result<list<s32>, spring-error>;
  get-units-in-cylinder: func(x: f32, z: f32, radius: f32, allegiance: s32) -> result<list<s32>, spring-error>;
  get-units-in-planes: func(planes: planes-query, allegiance: s32) -> result<list<s32>, spring-error>;
  get-units-in-rectangle: func(xmin: f32, zmin: f32, xmax: f32, zmax: f32, allegiance: s32) -> result<list<s32>, spring-error>;
  get-units-in-sphere: func(x: f32, y: f32, z: f32, radius: f32, allegiance: s32) -> result<list<s32>, spring-error>;
  valid-unit-id: func(unit-id: s32) -> result<bool, spring-error>;
}

interface units-weapons {
  record spring-error { code: s32 }

  record float3 {
    x: f32,
