  unit-weapon-fire: func(unit-id: s32, weapon-num: s32) -> result<bool, spring-error>;
  unit-weapon-hold-fire: func(unit-id: s32, weapon-num: s32) -> result<bool, spring-error>;
  use-unit-resource: func(unit-id: s32, resource-type: string, amount: f32) -> result<bool, spring-error>;
}

interface unit-defs {
  record spring-error { code: s32 }

  record get-unit-def-by-id-value {
    exists: bool,
    basic: unit-def-basic-info,
    costs: unit-def-costs,
    physics: unit-def-physics,
    weapons: unit-def-weapons,
    build-options: unit-def-build-options,
    sensors: unit-def-sensors,
    health: unit-def-health,
    classify: unit-def-classify,
  }

  record unit-def-basic-info {
    id: s32,
    name: string,
    human-name: string,
    tooltip: string,
    unit-def-id: s32,
  }

  record unit-def-build-options {
    buildable-unit-def-i-ds: list<s32>,
  }

  record unit-def-classify {
    is-transport: bool,
    is-immobile: bool,
    is-building: bool,
    is-builder: bool,
    is-mobile-builder: bool,
    is-static-builder: bool,
    is-factory: bool,
    is-extractor: bool,
    is-ground-unit: bool,
    is-air-unit: bool,
    is-strafing-air-unit: bool,
    is-hovering-air-unit: bool,
    is-fighter-air-unit: bool,
    is-bomber-air-unit: bool,
  }

  record unit-def-costs {
    metal-cost: f32,
    energy-cost: f32,
    build-time: f32,
  }

  record unit-def-health {
    health: f32,
    auto-heal: f32,
    idle-auto-heal: f32,
    idle-time: s32,
  }

  record unit-def-physics {
    mass: f32,
    height: f32,
    radius: f32,
    speed: f32,
    turn-rate: f32,
    acceleration: f32,
    brake-rate: f32,
    can-fly: bool,
    can-move: bool,
    can-hover: bool,
    float-on-water: bool,
    move-def-id: s32,
    can-submerge: bool,
    waterline: f32,
    min-water-depth: f32,
    max-water-depth: f32,
  }

  record unit-def-sensors {
    los-radius: f32,
    air-los-radius: f32,
    radar-radius: f32,
    sonar-radius: f32,
    seismic-radius: f32,
    radar-jammer-radius: f32,
    sonar-jammer-radius: f32,
  }

  record unit-def-weapons {
    weapon-def-i-ds: list<s32>,
  }

  get-unit-def-by-id: func(unit-def-id: s32) -> result<get-unit-def-by-id-value, spring-error>;
  get-unit-def-costs: func(unit-def-id: s32) -> result<unit-def-costs, spring-error>;
  get-unit-def-count: func(unused: u8) -> result<u32, spring-error>;
  get-unit-def-custom-param: func(unit-def-id: s32, key: string) -> result<string, spring-error>;
  get-unit-def-custom-param-keys: func(unit-def-id: s32) -> result<list<string>, spring-error>;
  get-unit-def-health: func(unit-def-id: s32) -> result<f32, spring-error>;
  get-unit-def-human-name: func(unit-def-id: s32) -> result<string, spring-error>;
  get-unit-def-id-by-name: func(unit-def-name: string) -> result<s32, spring-error>;
  get-unit-def-i-ds: func(unused: u8) -> result<list<s32>, spring-error>;
  get-unit-def-name: func(unit-def-id: s32) -> result<string, spring-error>;
  get-unit-def-speed: func(unit-def-id: s32) -> result<f32, spring-error>;
  valid-unit-def-id: func(unit-def-id: s32) -> result<bool, spring-error>;
}

interface units-commands {
  record spring-error { code: s32 }

  record build-queue-entry {
    unit-def-id: s32,
    num-ordered: u32,
  }

  record command-description {
    cmd-id: s32,
    action: string,
    %type: s32,
    name: string,
    tooltip: string,
    texture: string,
    cursor: string,
    queueing: bool,
    hidden: bool,
    disabled: bool,
    show-unique: bool,
    only-texture: bool,
    params: list<string>,
  }

  record command-ffi {
    cmd-id: s32,
    options: u8,
    tag: s32,
    ai-command-id: s32,
    time-out: f32,
    params: list<f32>,
  }

  record factory-queue-info {
    total-count: u32,
    current-count: u32,
    unit-def-i-ds: list<s32>,
    counts: list<u32>,
  }

  record find-unit-cmd-desc-value {
    cmd-index: s32,
    found: bool,
  }

  find-unit-cmd-desc: func(unit-id: s32, cmd-id: s32) -> result<find-unit-cmd-desc-value, spring-error>;
  get-command-queue: func(unit-id: s32, max-commands: u32) -> result<list<command-ffi>, spring-error>;
  get-factory-command-count: func(unit-id: s32) -> result<u32, spring-error>;
  get-factory-commands: func(unit-id: s32, max-commands: u32) -> result<list<command-ffi>, spring-error>;
  get-factory-counts: func(unit-id: s32, count: s32, add-cmds: bool) -> result<factory-queue-info, spring-error>;
  get-full-build-queue: func(unit-id: s32) -> result<list<build-queue-entry>, spring-error>;
  get-real-build-queue: func(unit-id: s32) -> result<list<s32>, spring-error>;
  get-unit-cmd-descs: func(unit-id: s32) -> result<list<command-description>, spring-error>;
  get-unit-command-count: func(unit-id: s32) -> result<u32, spring-error>;
  get-unit-commands: func(unit-id: s32, max-commands: u32) -> result<list<command-ffi>, spring-error>;
  get-unit-current-command: func(unit-id: s32, cmd-index: s32) -> result<option<command-ffi>, spring-error>;
  give-order-to-unit-map: func(unit-i-ds: list<s32>, cmd-id: s32, params: list<f32>, options: u32, timeout: s32) -> result<s32, spring-error>;
}

interface units-info {
  record spring-error { code: s32 }

  record collision-volume-data {
    scale-x: f32,
    scale-y: f32,
    scale-z: f32,
    offset-x: f32,
    offset-y: f32,
    offset-z: f32,
    volume-type: s32,
    test-type: s32,
    primary-axis: s32,
    disabled: bool,
  }

  record float3 {
    x: f32,
    y: f32,
    z: f32,
  }

  record get-unit-is-transporting-value {
    unit-i-ds: list<s32>,
    is-transporting: bool,
  }

  record get-unit-position-options {
    mid-pos: bool,
    aim-pos: bool,
  }

  record last-hit-piece {
    name: string,
    piece-num: s32,
    frame: s32,
    was-hit: bool,
  }

  record number-or-bool {
    number: f32,
    boolean: bool,
    use-boolean: bool,
  }

  record unit-armored-state {
    armored: bool,
    armor-multiple: f32,
  }

  record unit-blocking-state {
