interface unit-control {
  record spring-error { code: s32 }

  record bugger-off-options {
    spherical: bool,
    forced: bool,
    exclude-unit-id: s32,
  }

  record create-unit-options {
    build: bool,
    flatten-ground: bool,
    unit-id: s32,
    builder-id: s32,
  }

  record def-ref {
    name: string,
    id: s32,
  }

  record destroy-unit-options {
    selfd: bool,
    reclaimed: bool,
    attacker-id: s32,
    recycle-id: bool,
  }

  record float3 {
    x: f32,
    y: f32,
    z: f32,
  }

  record native-command {
    cmd-id: s32,
    params: list<f32>,
    options: u32,
    timeout: s32,
  }

  record native-command-description {
    id: s32,
    %type: s32,
    queueing: bool,
    hidden: bool,
    disabled: bool,
    show-unique: bool,
    only-texture: bool,
    name: string,
    action: string,
    iconname: string,
    mouseicon: string,
    tooltip: string,
    params: list<string>,
  }

  record number-or-bool {
    number: f32,
    boolean: bool,
    use-boolean: bool,
  }

  record set-unit-blocking-options {
    blocking: bool,
    solid-objects: bool,
    projectiles: bool,
    quad-map-rays: bool,
    crushable: bool,
    block-enemy-pushing: bool,
    block-height-changes: bool,
