  get-team-list: func(ally-team-id: s32) -> result<list<s32>, spring-error>;
  get-team-lua-ai: func(team-id: s32) -> result<string, spring-error>;
  get-team-max-units: func(team-id: s32) -> result<s32, spring-error>;
