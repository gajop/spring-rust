  }

  record unit-costs {
    metal-cost: f32,
    energy-cost: f32,
    build-time: f32,
  }

  record unit-flanking {
    flanking-mode: u32,
    move-factor: f32,
    min-damage: f32,
    max-damage: f32,
    direction: float3,
    mobility: f32,
  }

  record unit-harvest-storage {
    stored-metal: f32,
    max-stored-metal: f32,
    stored-energy: f32,
    max-stored-energy: f32,
  }

  record unit-health {
    health: f32,
    max-health: f32,
    paralyze-damage: f32,
    capture-progress: f32,
    build-progress: f32,
  }

  record unit-last-attacker {
    attacker-id: s32,
    attacker-def-id: s32,
    attacker-team: s32,
  }

  record unit-los-state {
    raw-mask: u8,
    los: bool,
    radar: bool,
    typed: bool,
  }

  record unit-pos-error-params {
    pos-error-vector: float3,
    pos-error-delta: float3,
    next-pos-error-update: s32,
    pos-error-bit: bool,
  }

  record unit-resources {
    metal-make: f32,
    metal-use: f32,
    energy-make: f32,
    energy-use: f32,
    metal-income: f32,
    energy-income: f32,
  }

  record unit-rotation {
    pitch: f32,
    yaw: f32,
    roll: f32,
  }

  record unit-sensor-radius {
    los: f32,
    air-los: f32,
    radar: f32,
    sonar: f32,
    seismic: f32,
    radar-jammer: f32,
    sonar-jammer: f32,
  }

  record unit-shield-state {
    shield-enabled: bool,
    shield-power: f32,
    shield-alpha: f32,
  }

  record unit-states {
    fire-state: s32,
    move-state: s32,
    auto-repair-level: f32,
    repeat: bool,
    cloak: bool,
    active: bool,
    trajectory: bool,
    auto-land: bool,
    loopback-attack: bool,
  }

  record unit-states-options {
    ret-table: bool,
    bin-state: bool,
    amt-state: bool,
  }

  record unit-stockpile {
    stockpile: u32,
    stockpile-queue-size: u32,
    build-percent: f32,
  }

  record unit-storage {
    metal-storage: f32,
    energy-storage: f32,
  }

  record unit-vectors {
    front-dir: float3,
    up-dir: float3,
    right-dir: float3,
  }

  record unit-worker-task {
    cmd-id: s32,
    target-id: s32,
    has-task: bool,
    has-target: bool,
  }

  get-unit-ally-team: func(unit-id: s32) -> result<s32, spring-error>;
  get-unit-armored: func(unit-id: s32) -> result<unit-armored-state, spring-error>;
  get-unit-base-position: func(unit-id: s32) -> result<float3, spring-error>;
  get-unit-blocking: func(unit-id: s32) -> result<unit-blocking-state, spring-error>;
  get-unit-build-facing: func(unit-id: s32) -> result<s32, spring-error>;
  get-unit-build-params: func(unit-id: s32, param-name: string) -> result<option<number-or-bool>, spring-error>;
  get-unit-buildee-radius: func(unit-id: s32) -> result<f32, spring-error>;
  get-unit-collision-volume-data: func(unit-id: s32) -> result<collision-volume-data, spring-error>;
  get-unit-cost-table: func(unit-id: s32) -> result<unit-costs, spring-error>;
  get-unit-costs: func(unit-id: s32) -> result<unit-costs, spring-error>;
  get-unit-current-build-power: func(unit-id: s32) -> result<f32, spring-error>;
  get-unit-def-id: func(unit-id: s32) -> result<s32, spring-error>;
  get-unit-direction: func(unit-id: s32) -> result<float3, spring-error>;
  get-unit-effective-build-range: func(unit-id: s32, buildee-def-id: s32) -> result<f32, spring-error>;
  get-unit-experience: func(unit-id: s32) -> result<f32, spring-error>;
  get-unit-flanking: func(unit-id: s32) -> result<unit-flanking, spring-error>;
  get-unit-harvest-storage: func(unit-id: s32) -> result<unit-harvest-storage, spring-error>;
  get-unit-heading: func(unit-id: s32, convert-to-radians: bool) -> result<f32, spring-error>;
  get-unit-health: func(unit-id: s32) -> result<unit-health, spring-error>;
  get-unit-height: func(unit-id: s32) -> result<f32, spring-error>;
  get-unit-in-build-stance: func(unit-id: s32) -> result<bool, spring-error>;
  get-unit-is-active: func(unit-id: s32) -> result<bool, spring-error>;
  get-unit-is-being-built: func(unit-id: s32) -> result<bool, spring-error>;
  get-unit-is-building: func(unit-id: s32) -> result<s32, spring-error>;
  get-unit-is-cloaked: func(unit-id: s32) -> result<bool, spring-error>;
  get-unit-is-dead: func(unit-id: s32) -> result<bool, spring-error>;
  get-unit-is-stunned: func(unit-id: s32) -> result<bool, spring-error>;
  get-unit-is-transporting: func(unit-id: s32) -> result<get-unit-is-transporting-value, spring-error>;
  get-unit-last-attacked-piece: func(unit-id: s32) -> result<last-hit-piece, spring-error>;
  get-unit-last-attacker: func(unit-id: s32) -> result<option<unit-last-attacker>, spring-error>;
  get-unit-los-state: func(unit-id: s32, ally-team-id: s32, raw: bool) -> result<unit-los-state, spring-error>;
