;; This file is part of the Spring engine (GPL v2 or later), see LICENSE.html
;; Template used ONLY in isolated games. ENV_MASK, NAME and OTHER are replaced
;; by the local harness. Two persistent chains check ordering, fresh globals,
;; copied input, own/named submissions and result callbacks without GameFrame.
(module
  (import "spring:jobs" "submit" (func $submit (param i32 i32 i32 i32) (result i64)))
  (import "spring:jobs" "submit-to" (func $submit_to (param i32 i32 i32 i32 i32 i32) (result i64)))
  (import "spring:messages" "echo" (func $echo (param i32 i32 i32 i32) (result i64)))
  (memory (export "memory") 2 2)
  (global $started (mut i32) (i32.const 0))
  (global $submitted (mut i32) (i32.const 0))
  (global $delivered (mut i32) (i32.const 0))
  (global $calls (mut i32) (i32.const 0))
  (data (i32.const 256) "work")
  (data (i32.const 320) "@NAME@")
  (data (i32.const 400) "@OTHER@")
  (data (i32.const 512) "JOBS_ENV_@NAME@_BOOT")
  (data (i32.const 640) "JOBS_ENV_@NAME@_RESULTS_100")
  (data (i32.const 768) "JOBS_ENV_@NAME@_RESULTS_400")
  (data (i32.const 896) "JOBS_ENV_@NAME@_RESULTS_10")
  (func (export "SPRING_ENV_MASK") (result i32) i32.const @ENV_MASK@)
  (func (export "SPRING_JOB_INPUT_BUFFER") (result i32) i32.const 1024)
  (func (export "SPRING_JOB_INPUT_CAPACITY") (result i32) i32.const 4096)
  (func (export "SPRING_JOB_RESULT_BUFFER") (result i32) i32.const 8192)
  (func (export "SPRING_JOB_RESULT_CAPACITY") (result i32) i32.const 4096)
  (func $assert (param $ok i32) local.get $ok i32.eqz if unreachable end)
  (func $message (param $ptr i32) (param $len i32)
    local.get $ptr local.get $len i32.const 0 i32.const 0 call $echo
    i64.const 32 i64.shr_u i64.eqz call $assert)
  (func $work (export "work") (param $ptr i32) (param $len i32) (result i64)
    (local $v i32) (local $n i32)
    local.get $ptr i32.load local.set $v
    local.get $ptr i32.load offset=4 local.set $n
    block $done loop $loop
      local.get $n i32.eqz br_if $done
      local.get $v i32.const 1664525 i32.mul i32.const 1013904223 i32.add local.set $v
      local.get $n i32.const 1 i32.sub local.set $n br $loop
    end end
    global.get $calls i32.const 1 i32.add global.set $calls
    i32.const 32 local.get $v i32.store
    i32.const 36 global.get $calls i32.store
    i32.const 40 local.get $ptr i32.load offset=8 i32.store
    i64.const 51539607584)
  (func $enqueue (local $seq i32) (local $slot i32) (local $id i64)
    global.get $submitted i32.const 1 i32.add local.tee $seq global.set $submitted
    local.get $seq i32.const 63 i32.and i32.const 8 i32.mul i32.const 2048 i32.add local.set $slot
    i32.const 1024 local.get $seq i32.const @ENV_MASK@ i32.add i32.store
    i32.const 1028 local.get $seq i32.const 1 i32.and
    if (result i32) i32.const 200000 else i32.const 5000 end i32.store
    i32.const 1032 local.get $seq i32.store
    i32.const 1024 i32.const 12 call $work drop
    local.get $slot i32.const 32 i32.load i32.store
    local.get $seq i32.const 1 i32.and
    if (result i64)
      i32.const 256 i32.const 4 i32.const 1024 i32.const 12 call $submit
    else
      i32.const 320 i32.const @NAME_LEN@ i32.const 256 i32.const 4 i32.const 1024 i32.const 12 call $submit_to
    end local.set $id
    local.get $id i64.const 32 i64.shr_u i64.eqz call $assert
    local.get $slot local.get $id i32.wrap_i64 i32.store offset=4
    i32.const 1024 i32.const -1 i32.store)
  (func $bootstrap
    global.get $started if return end
    i32.const 1 global.set $started
    ;; A worker in a different capability category must remain unavailable.
    i32.const 400 i32.const @OTHER_LEN@ i32.const 256 i32.const 4 i32.const 1024 i32.const 12 call $submit_to
    i64.const 32 i64.shr_u i64.const 3 i64.eq call $assert
    call $enqueue call $enqueue
    i32.const 512 i32.const @BOOT_LEN@ call $message)
  @CLOCK_EXPORTS@
  (func (export "spring:jobs/result") (param $id i32) (param $status i32) (param $ptr i32) (param $len i32)
    (local $seq i32) (local $slot i32)
    local.get $status i32.eqz call $assert
    local.get $len i32.const 12 i32.eq call $assert
    global.get $delivered i32.const 1 i32.add local.tee $seq global.set $delivered
    local.get $seq i32.const 63 i32.and i32.const 8 i32.mul i32.const 2048 i32.add local.set $slot
    local.get $ptr i32.load local.get $slot i32.load i32.eq call $assert
    local.get $id local.get $slot i32.load offset=4 i32.eq call $assert
    local.get $ptr i32.load offset=4 i32.const 1 i32.eq call $assert
    local.get $ptr i32.load offset=8 local.get $seq i32.eq call $assert
    local.get $seq i32.const 10 i32.eq if i32.const 896 i32.const @R10_LEN@ call $message end
    local.get $seq i32.const 100 i32.eq if i32.const 640 i32.const @R100_LEN@ call $message end
    local.get $seq i32.const 400 i32.eq if i32.const 768 i32.const @R400_LEN@ call $message end
    call $enqueue))
