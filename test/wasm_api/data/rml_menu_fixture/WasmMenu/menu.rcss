body {
	display: block;
	width: 100%;
	height: 100%;
	margin: 0;
}

#menu-panel {
	display: block;
	width: 520px;
	height: 280px;
	margin: 40px 0 0 80px;
	padding: 24px;
	background-color: #18202b;
	color: #e9eef5;
	font-family: FreeSans;
}

#title,
#status,
#fixture-image,
#name,
#launch {
	display: block;

	/* Keep the fixture legible with RmlUi's intentionally small default sheet. */
	margin-left: 0;
	margin-right: 0;
}

#title {
	margin-top: 0;
}

#status {
	margin-top: 12px;
}

#fixture-image {
	margin-top: 12px;
}

#name {
	width: 220px;
	margin-top: 12px;
}

#launch {
	width: 160px;
	margin-top: 18px;
	padding: 8px 20px;
	background-color: #385b83;
}

#launch:hover {
	background-color: #5f9bd4;
}

#fixture-image {
	width: 64px;
	height: 64px;
}
