package recoil:spring-api@1.0.0;

interface units-query {
  record spring-error { code: s32 }

  variant choice {
    none,
    number(u32),
    text(string),
  }

  echo-choice: func(value: choice) -> result<choice, spring-error>;
}

interface resource-fixture {
  use units-query.{choice, spring-error};

  resource token;

  record resource-input {
    token: own<token>,
    required: u32,
  }

  echo-choice: func(value: choice) -> result<choice, spring-error>;
  make-token: func() -> own<token>;
  consume-pair: func(input: resource-input) -> u32;
  consume-token: func(value: own<token>) -> u32;
}

world rules-synced {
  import units-query;
  export resource-fixture;
}
