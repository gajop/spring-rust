{
  "version": 1,
  "tests": [
    {
      "id": "terrain_add_grass",
      "context": "synced_gadget",
      "kind": "readonly",
      "native_only": true,
      "requires": ["ground_point"],
      "lua": {"set": [], "get": ["Spring.AddGrass"]},
      "native": {"set": [], "get": ["TerrainControl.add_grass"]},
      "compare": {"mode": "fields", "epsilon": 0.05, "fields": ["returnCount", "postGrassLevel"]},
      "rust": {"check": "check_terrain_control_result", "set": "set_terrain_control_call"},
      "params": {
        "point": {"type": "float2", "generator": "map_point", "expands_to": ["x", "z"]},
        "grass": {"type": "i32", "range": [0, 3]}
      },
      "lua_runtime": {
        "call": "Spring.AddGrass",
        "args": ["value.x", "value.z", "value.grass"],
        "returns": [{"field": "returnCount", "transform": "return_count"}],
        "post": [{"call": "Spring.GetGrass", "args": ["value.x", "value.z"], "returns": ["postGrassLevel"]}]
      },
      "wasm_sequence": [
        {"call": "TerrainControl.add_grass", "args": ["value.x", "value.z", "value.grass"], "bind": "returnCount", "require_true": true},
        {"call": "Terrain.get_grass", "args": ["value.x", "value.z"], "bind": "postGrassLevel"}
      ],
      "wasm_returns": [
        {"field": "returnCount", "from": "returnCount", "transform": "return_count"},
        {"field": "postGrassLevel", "from": "postGrassLevel"}
      ]
    },
