        {"field": "postGroundHeight", "from": "postGroundHeight"},
        {"field": "postNormalX", "from": "postNormal", "path": ["normal", "x"]},
        {"field": "postNormalY", "from": "postNormal", "path": ["normal", "y"]},
        {"field": "postNormalZ", "from": "postNormal", "path": ["normal", "z"]},
        {"field": "postAffectedGroundHeight", "from": "postAffectedGroundHeight"}
