        "post": [
          {"call": "Spring.GetGroundHeight", "args": ["value.x1", "value.z1"], "returns": ["postGroundHeight"]},
          {"call": "Spring.GetGroundNormal", "args": ["value.x1", "value.z1", false], "returns": ["postNormalX", "postNormalY", "postNormalZ"]},
          {"call": "Spring.GetGroundHeight", "args": [880, 919.315979], "returns": ["postAffectedGroundHeight"]}
