{
  "version": 1,
  "tests": [
    {
      "id": "unit_cmd_desc_lifecycle",
      "context": "synced_gadget",
      "kind": "setter_getter",
      "requires": ["unit"],
      "lua": {
        "set": ["Spring.InsertUnitCmdDesc", "Spring.EditUnitCmdDesc", "Spring.RemoveUnitCmdDesc"],
        "get": ["Spring.GetUnitCmdDescs"]
      },
      "native": {
        "set": ["UnitControl.insert_unit_cmd_desc", "UnitControl.edit_unit_cmd_desc", "UnitControl.remove_unit_cmd_desc"],
        "get": ["UnitsCommands.get_unit_cmd_descs"]
      },
      "compare": {"mode": "fields", "fields": ["success"]},
      "report": {
        "lua_setter": "`Spring.InsertUnitCmdDesc`, `Spring.EditUnitCmdDesc`, `Spring.RemoveUnitCmdDesc`",
        "native_setter": "`UnitControl.insert_unit_cmd_desc`, `UnitControl.edit_unit_cmd_desc`, `UnitControl.remove_unit_cmd_desc`",
        "lua_getter": "`Spring.GetUnitCmdDescs`",
        "native_getter": "`UnitsCommands.get_unit_cmd_descs`",
        "fields": "`success`"
      },
      "rust": {"check": "check_unit_cmd_desc_lifecycle", "set": "set_unit_cmd_desc_lifecycle"},
      "params": {
        "cmdID": {"type": "i32", "fixed": 34567},
        "cmdType": {"type": "i32", "fixed": 21},
        "action": {"type": "string", "fixed": "native_api_parity_cmd"},
        "editedAction": {"type": "string", "fixed": "native_api_parity_cmd_edited"}
      },
      "lua_runtime": {
        "sequence": [
          {"call": "Spring.InsertUnitCmdDesc", "args": ["fixture.unitID", {"id": "value.cmdID", "type": "value.cmdType", "queueing": false, "hidden": false, "disabled": false, "showUnique": false, "onlyTexture": false, "name": "Native parity command", "action": "value.action", "iconname": "", "mouseicon": "", "tooltip": "Native parity command", "params": ["native_api_parity"]}], "bind": "inserted"},
          {"call": "Spring.FindUnitCmdDesc", "args": ["fixture.unitID", "value.cmdID"], "bind": "found"},
          {"call": "Spring.EditUnitCmdDesc", "args": ["fixture.unitID", "sequence.found.cmdIndex", {"id": "value.cmdID", "type": "value.cmdType", "queueing": false, "hidden": false, "disabled": false, "showUnique": false, "onlyTexture": false, "name": "Native parity command", "action": "value.editedAction", "iconname": "", "mouseicon": "", "tooltip": "Native parity command", "params": ["native_api_parity"]}], "bind": "edited"},
          {"call": "Spring.RemoveUnitCmdDesc", "args": ["fixture.unitID", "sequence.found.cmdIndex"], "bind": "removed"},
          {"call": "Spring.FindUnitCmdDesc", "args": ["fixture.unitID", "value.cmdID"], "bind": "after"}
        ],
        "returns": [
          {"field": "success", "from": "after", "path": ["found"], "transform": "not"}
        ]
      },
      "wasm_sequence": [
        {"call": "UnitControl.insert_unit_cmd_desc", "args": ["fixture.unitID", -1, {"id": "value.cmdID", "type": "value.cmdType", "queueing": false, "hidden": false, "disabled": false, "showUnique": false, "onlyTexture": false, "name": "Native parity command", "action": "value.action", "iconname": "", "mouseicon": "", "tooltip": "Native parity command", "params": ["native_api_parity"]}], "bind": "inserted", "require_true": true},
        {"call": "UnitsCommands.find_unit_cmd_desc", "args": ["fixture.unitID", "value.cmdID"], "bind": "found"},
        {"call": "UnitControl.edit_unit_cmd_desc", "args": ["fixture.unitID", "sequence.found.cmdIndex", {"id": "value.cmdID", "type": "value.cmdType", "queueing": false, "hidden": false, "disabled": false, "showUnique": false, "onlyTexture": false, "name": "Native parity command", "action": "value.editedAction", "iconname": "", "mouseicon": "", "tooltip": "Native parity command", "params": ["native_api_parity"]}], "bind": "edited", "require_true": true},
        {"call": "UnitControl.remove_unit_cmd_desc", "args": ["fixture.unitID", "sequence.found.cmdIndex"], "bind": "removed", "require_true": true},
        {"call": "UnitsCommands.find_unit_cmd_desc", "args": ["fixture.unitID", "value.cmdID"], "bind": "after"}
      ]
    },
    {
      "id": "solve_nurbscurve",
      "context": "unsynced_gadget",
      "kind": "readonly",
      "requires": [],
      "lua": {"set": [], "get": ["Spring.SolveNURBSCurve"]},
      "native": {"set": [], "get": ["UnsyncedRead.solve_nurbscurve"]},
      "compare": {"mode": "fields", "epsilon": 0.05, "fields": ["points"]},
      "report": {
        "lua_setter": "n/a",
        "native_setter": "n/a",
        "lua_getter": "`Spring.SolveNURBSCurve`",
        "native_getter": "`UnsyncedRead.solve_nurbscurve`",
        "fields": "`points`"
      },
      "rust": {"check": "check_unsynced_read_value", "set": "set_noop"},
      "params": {
        "degree": {"type": "i32", "fixed": 2},
        "controlPoints": {"type": "object", "fixed": [0, 0, 0, 1, 256, 64, 128, 1, 512, 0, 256, 1]},
        "points": {"type": "object", "fixed": [
          {"x": 0, "y": 0, "z": 0, "w": 1},
          {"x": 256, "y": 64, "z": 128, "w": 1},
          {"x": 512, "y": 0, "z": 256, "w": 1}
        ]},
        "knots": {"type": "object", "fixed": [0, 0, 0, 1, 1, 1]},
        "segments": {"type": "i32", "fixed": 4}
      },
      "wasm_args": ["value.degree", "value.points", "value.knots", "value.segments"],
      "lua_runtime": {
        "call": "Spring.SolveNURBSCurve",
        "args": ["value.degree", "value.controlPoints", "value.knots", "value.segments"],
        "returns": [{"field": "points", "index": 1, "transform": "flat_float3_list"}]
      }
    },
    {
      "id": "set_original_height_map",
      "context": "synced_gadget",
      "kind": "setter_getter",
      "requires": [],
      "lua": {
        "set": ["Spring.SetOriginalHeightMapFunc", "Spring.SetOriginalHeightMap"],
        "get": ["Spring.GetGroundOrigHeight"]
      },
      "native": {
        "set": ["TerrainControl.set_original_height_map_func", "TerrainControl.set_original_height_map"],
        "get": ["Terrain.get_ground_orig_height"]
      },
      "compare": {"mode": "fields", "epsilon": 0.05, "fields": ["height"]},
      "report": {
        "lua_setter": "`Spring.SetOriginalHeightMapFunc`, `Spring.SetOriginalHeightMap`",
        "native_setter": "`TerrainControl.set_original_height_map_func`, `TerrainControl.set_original_height_map`",
        "lua_getter": "`Spring.GetGroundOrigHeight`",
        "native_getter": "`Terrain.get_ground_orig_height`",
        "fields": "`height`"
      },
      "rust": {"check": "check_remaining_synced", "set": "set_remaining_synced"},
      "params": {
        "x": {"type": "f32", "fixed": 1600},
        "z": {"type": "f32", "fixed": 1600},
        "height": {"type": "f32", "wasm_fixed": 106},
        "factor": {"type": "f32", "fixed": 0.5}
      },
      "lua_runtime": null,
      "wasm_sequence": [
        {"call": "TerrainControl.set_original_height_map_func", "args": [1, 0], "bind": "registered"},
        {"call": "Terrain.get_ground_orig_height", "args": ["value.x", "value.z"], "bind": "height"}
      ],
      "wasm_callback": {"mode": "set_original_height_map", "call": "TerrainControl.set_original_height_map", "args": ["value.x", "value.z", "value.height", "value.factor"], "team": 0},
      "wasm_returns": [{"field": "height", "from": "height"}]
    },
    {
      "id": "set_smooth_mesh",
      "context": "synced_gadget",
      "kind": "setter_getter",
      "requires": [],
      "lua": {
        "set": ["Spring.SetSmoothMeshFunc", "Spring.SetSmoothMesh"],
        "get": ["Spring.GetSmoothMeshHeight"]
      },
      "native": {
        "set": ["TerrainControl.set_smooth_mesh_func", "TerrainControl.set_smooth_mesh"],
        "get": ["Terrain.get_smooth_mesh_height"]
      },
      "compare": {"mode": "fields", "epsilon": 0.05, "fields": ["height"]},
      "report": {
        "lua_setter": "`Spring.SetSmoothMeshFunc`, `Spring.SetSmoothMesh`",
        "native_setter": "`TerrainControl.set_smooth_mesh_func`, `TerrainControl.set_smooth_mesh`",
        "lua_getter": "`Spring.GetSmoothMeshHeight`",
        "native_getter": "`Terrain.get_smooth_mesh_height`",
        "fields": "`height`"
      },
      "rust": {"check": "check_remaining_synced", "set": "set_remaining_synced"},
      "params": {
        "x": {"type": "f32", "fixed": 1600},
        "z": {"type": "f32", "fixed": 1600},
        "height": {"type": "f32", "wasm_fixed": 106},
        "terraform": {"type": "f32", "fixed": 0.5}
      },
      "lua_runtime": null,
      "wasm_sequence": [
        {"call": "TerrainControl.set_smooth_mesh_func", "args": [1, 0], "bind": "registered"},
        {"call": "Terrain.get_smooth_mesh_height", "args": ["value.x", "value.z"], "bind": "height"}
      ],
      "wasm_callback": {"mode": "set_smooth_mesh", "call": "TerrainControl.set_smooth_mesh", "args": ["value.x", "value.z", "value.height", "value.terraform"], "team": 0},
      "wasm_returns": [{"field": "height", "from": "height"}]
    }
  ]
}
