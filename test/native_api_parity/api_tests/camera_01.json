      "id": "get_camera_names",
      "context": "unsynced_gadget",
      "kind": "readonly",
      "requires": [],
      "lua": {"set": [], "get": ["Spring.GetCameraNames"]},
      "native": {"set": [], "get": ["Camera.get_camera_names"]},
      "compare": {"mode": "fields", "fields": ["names"]},
      "order_insensitive_fields": ["names"],
      "report": {"lua_setter": "n/a", "native_setter": "n/a", "lua_getter": "`Spring.GetCameraNames`", "native_getter": "`Camera.get_camera_names`", "fields": "`names`"},
      "rust": {"check": "check_camera_value", "set": "set_noop"},
      "params": {},
      "lua_runtime": {"call": "Spring.GetCameraNames", "args": [], "returns": [{"field": "names", "index": 1, "transform": "table_keys"}]}
    },
