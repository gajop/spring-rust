          "args": [
            "fixture.featureID",
            "value.radius",
            "value.height"
          ]
        },
        "call": "Spring.GetFeatureRadius",
        "args": [
          "fixture.featureID"
        ],
        "returns": [
          "radius"
        ]
      }
    },
