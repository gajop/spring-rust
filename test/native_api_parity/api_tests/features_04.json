{
  "version": 1,
  "tests": [
    {
      "id": "feature_collision_volume_data",
      "context": "synced_gadget",
      "kind": "setter_getter",
      "requires": [
        "feature"
      ],
      "lua": {
        "set": [
          "Spring.SetFeatureCollisionVolumeData"
        ],
        "get": [
          "Spring.GetFeatureCollisionVolumeData"
        ]
      },
      "native": {
        "set": [
          "FeatureControl.set_feature_collision_volume_data"
        ],
        "get": [
          "Features.get_feature_collision_volume_data"
        ]
      },
      "compare": {
        "mode": "fields",
        "epsilon": 0.05,
        "fields": [
          "scaleX",
          "scaleY",
          "scaleZ",
          "offsetX",
          "offsetY",
          "offsetZ",
          "volumeType",
          "testType",
          "primaryAxis",
          "disabled"
        ]
      },
      "report": {
        "lua_setter": "`Spring.SetFeatureCollisionVolumeData`",
        "native_setter": "`FeatureControl.set_feature_collision_volume_data`",
        "lua_getter": "`Spring.GetFeatureCollisionVolumeData`",
        "native_getter": "`Features.get_feature_collision_volume_data`",
        "fields": "`scaleX`, `scaleY`, `scaleZ`, `offsetX`, `offsetY`, `offsetZ`, `volumeType`, `testType`, `primaryAxis`, `disabled`"
      },
      "rust": {
        "check": "check_feature_collision_volume_data",
        "set": "set_feature_collision_volume_data"
      },
      "params": {
        "scaleX": {
          "type": "f32",
          "range": [
            8,
            72
          ]
        },
        "scaleY": {
          "type": "f32",
          "range": [
            8,
            72
          ]
        },
        "scaleZ": {
          "type": "f32",
          "range": [
            8,
            72
          ]
        },
        "offsetX": {
          "type": "f32",
          "range": [
            -12,
            12
          ]
        },
        "offsetY": {
          "type": "f32",
          "range": [
            -12,
            12
          ]
        },
        "offsetZ": {
          "type": "f32",
          "range": [
            -12,
            12
          ]
        },
        "volumeType": {
          "type": "enum",
          "values": [
            0,
            1,
            2,
            3
          ]
        },
        "testType": {
          "type": "enum",
          "values": [
            0,
            1
          ]
        },
        "primaryAxis": {
          "type": "enum",
          "values": [
            0,
            1,
            2
          ]
        }
      },
      "lua_runtime": {
        "set": {
          "call": "Spring.SetFeatureCollisionVolumeData",
          "args": [
            "fixture.featureID",
            "value.scaleX",
            "value.scaleY",
            "value.scaleZ",
            "value.offsetX",
            "value.offsetY",
            "value.offsetZ",
            "value.volumeType",
            "value.testType",
            "value.primaryAxis"
          ]
        },
        "call": "Spring.GetFeatureCollisionVolumeData",
        "args": [
          "fixture.featureID"
        ],
        "returns": [
          "scaleX",
          "scaleY",
          "scaleZ",
          "offsetX",
          "offsetY",
          "offsetZ",
          "volumeType",
          "testType",
          "primaryAxis",
          "disabled"
        ]
      }
    },
    {
