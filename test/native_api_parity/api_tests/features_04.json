        "native_setter": "`FeatureControl.set_feature_radius_and_height`",
        "lua_getter": "`Spring.GetFeatureRadius`",
        "native_getter": "`Features.get_feature_radius`",
        "fields": "`radius`"
      },
      "rust": {
        "check": "check_feature_radius",
        "set": "set_feature_radius_and_height"
      },
      "params": {
        "radius": {
          "type": "f32",
          "range": [
            8,
            80
          ]
        },
        "height": {
          "type": "f32",
          "range": [
            8,
            120
          ]
        }
      },
      "lua_runtime": {
        "set": {
