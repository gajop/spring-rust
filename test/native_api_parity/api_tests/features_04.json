    {
      "id": "feature_add_damage",
      "context": "synced_gadget",
      "kind": "setter_getter",
      "requires": [
        "feature"
      ],
      "lua": {
        "set": [
          "Spring.SetFeatureHealth",
          "Spring.AddFeatureDamage"
        ],
        "get": [
          "Spring.GetFeatureHealth"
        ]
      },
      "native": {
        "set": [
          "FeatureControl.set_feature_health",
          "FeatureControl.add_feature_damage"
        ],
        "get": [
          "Features.get_feature_health"
        ]
      },
      "compare": {
        "mode": "fields",
        "epsilon": 0.05,
        "fields": [
          "health"
        ]
      },
      "report": {
        "lua_setter": "`Spring.SetFeatureHealth`, `Spring.AddFeatureDamage`",
        "native_setter": "`FeatureControl.set_feature_health`, `FeatureControl.add_feature_damage`",
        "lua_getter": "`Spring.GetFeatureHealth`",
        "native_getter": "`Features.get_feature_health`",
        "fields": "`health`"
      },
      "rust": {
        "check": "check_feature_health",
        "set": "add_feature_damage"
      },
      "params": {
        "baseline": {
          "type": "f32",
          "range": [
            700,
            900
          ]
        },
        "damage": {
          "type": "f32",
          "range": [
            20,
            80
          ]
        }
      },
      "lua_runtime": {
        "set": [
          {
            "call": "Spring.SetFeatureHealth",
            "args": [
              "fixture.featureID",
              "value.baseline",
              false
            ]
          },
          {
            "call": "Spring.AddFeatureDamage",
            "args": [
              "fixture.featureID",
              "value.damage",
              0,
              -1,
              -1,
              0,
              0,
              0
            ]
          }
        ],
        "call": "Spring.GetFeatureHealth",
        "args": [
          "fixture.featureID"
        ],
        "returns": [
          "health"
        ]
      }
    },
    {
