{
  "version": 1,
  "tests": [
    {
      "id": "get_unit_command_count",
      "context": "synced_gadget",
      "kind": "readonly",
      "requires": [
        "unit"
      ],
      "lua": {
        "set": [],
        "get": [
          "Spring.GetUnitCommandCount"
        ]
      },
      "native": {
        "set": [],
        "get": [
          "UnitsCommands.get_unit_command_count"
        ]
      },
      "compare": {
        "mode": "fields",
        "epsilon": 0.05,
        "fields": [
          "count"
        ]
      },
      "report": {
        "lua_setter": "n/a",
        "native_setter": "n/a",
        "lua_getter": "`Spring.GetUnitCommandCount`",
        "native_getter": "`UnitsCommands.get_unit_command_count`",
        "fields": "`count`"
      },
      "rust": {
        "check": "check_unit_commands_count",
        "set": "set_noop"
      },
      "params": {},
      "lua_runtime": {
        "call": "Spring.GetUnitCommandCount",
        "args": [
          "fixture.unitID"
        ],
        "returns": [
          "count"
        ]
      }
    },
    {
