    {
      "id": "map_model_lights_lifecycle",
      "context": "unsynced_gadget",
      "kind": "readonly",
      "requires_rendering": true,
      "requires": ["unit"],
      "lua": {"set": [], "get": ["Spring.AddMapLight", "Spring.UpdateMapLight", "Spring.SetMapLightTrackingState", "Spring.AddModelLight", "Spring.UpdateModelLight", "Spring.SetModelLightTrackingState"]},
      "native": {"set": [], "get": ["Lights.add_map_light", "Lights.update_map_light", "Lights.set_map_light_tracking_state", "Lights.add_model_light", "Lights.update_model_light", "Lights.set_model_light_tracking_state"]},
      "compare": {"mode": "fields", "fields": ["mapAdded", "mapUpdated", "mapTracked", "mapUntracked", "modelAdded", "modelUpdated", "modelTracked", "modelUntracked"]},
      "rust": {"check": "check_control_calls", "set": "set_noop"},
      "params": {
        "lightParams": {"type": "object", "fixed": {"position": [1024, 128, 1024], "direction": [0, -1, 0], "ambientColor": [0.1, 0.2, 0.3], "diffuseColor": [0.4, 0.5, 0.6], "specularColor": [0.7, 0.8, 0.9], "radius": 128, "fov": 90, "ttl": 1000, "priority": 1, "ignoreLOS": true, "localSpace": false}}
      },
      "lua_runtime": null
    },
