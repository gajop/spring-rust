    {
      "id": "assign_mouse_cursor",
      "context": "unsynced_gadget",
      "kind": "readonly",
      "requires_rendering": true,
      "lua": {"set": [], "get": ["Spring.AssignMouseCursor"]},
      "native": {"set": [], "get": ["UnsyncedCtrl.assign_mouse_cursor"]},
      "compare": {"mode": "fields", "fields": ["result"]},
      "rust": {"check": "check_unsynced_control_call", "set": "set_noop"},
      "params": {
        "commandName": {"type": "string", "fixed": "NativeApiParityCursor"},
        "cursorFileName": {"type": "string", "fixed": "cursorattack"},
        "overwrite": {"type": "bool", "fixed": true},
        "hotSpotTopLeft": {"type": "bool", "fixed": false}
      },
      "lua_runtime": {"call": "Spring.AssignMouseCursor", "args": ["value.commandName", "value.cursorFileName", "value.overwrite", "value.hotSpotTopLeft"], "returns": [{"field": "result", "transform": "truthy"}]}
    },
