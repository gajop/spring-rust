{
  "version": 1,
  "tests": [
    {
      "id": "get_unit_weapon_state",
      "context": "synced_gadget",
      "kind": "readonly",
      "requires": [
        "unit"
      ],
      "lua": {
        "set": [],
        "get": [
          "Spring.GetUnitWeaponState"
        ]
      },
      "native": {
        "set": [],
        "get": [
          "UnitsWeapons.get_unit_weapon_state"
        ]
      },
      "compare": {
        "mode": "fields",
        "epsilon": 0.05,
        "fields": [
          "value"
        ]
      },
      "report": {
        "lua_setter": "n/a",
        "native_setter": "n/a",
        "lua_getter": "`Spring.GetUnitWeaponState`",
        "native_getter": "`UnitsWeapons.get_unit_weapon_state`",
        "fields": "`value`"
      },
      "rust": {
        "check": "check_unit_weapon_state_f32",
        "set": "set_noop"
      },
      "params": {
        "weaponNum": {
          "type": "i32",
          "fixed": 1
        },
        "key": {
          "type": "enum",
          "values": [
            "range",
            "projectileSpeed",
            "reloadFrame",
            "reloadTime"
          ]
        }
      },
      "lua_runtime": {
        "call": "Spring.GetUnitWeaponState",
        "args": [
          "fixture.unitID",
          "value.weaponNum",
          "value.key"
        ],
        "returns": [
          "value"
        ]
      }
    },
