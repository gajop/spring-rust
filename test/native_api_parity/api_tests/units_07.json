            "frontY",
            "frontZ",
            "rightX",
            "rightY",
            "rightZ"
          ]
        }
      },
      "lua_runtime": {
        "set": {
          "call": "Spring.SetUnitDirection",
          "args": [
            "fixture.unitID",
            "value.frontX",
            "value.frontY",
            "value.frontZ",
            "value.rightX",
            "value.rightY",
            "value.rightZ"
          ]
        },
        "call": "Spring.GetUnitDirection",
        "args": [
          "fixture.unitID"
