{
  "version": 1,
  "tests": [
    {
      "id": "unit_cloak",
      "context": "synced_gadget",
      "kind": "setter_getter",
      "requires": [
        "unit"
      ],
      "lua": {
        "set": [
          "Spring.SetUnitCloak"
        ],
        "get": [
          "Spring.GetUnitStates"
        ]
      },
      "native": {
        "set": [
          "UnitControl.set_unit_cloak"
        ],
        "get": [
          "UnitsInfo.get_unit_states"
        ]
      },
      "compare": {
        "mode": "fields",
        "epsilon": 0.05,
        "fields": [
          "cloak"
        ]
      },
      "report": {
        "lua_setter": "`Spring.SetUnitCloak`",
        "native_setter": "`UnitControl.set_unit_cloak`",
        "lua_getter": "`Spring.GetUnitStates`",
        "native_getter": "`UnitsInfo.get_unit_states`",
        "fields": "`cloak`"
      },
      "rust": {
        "check": "check_unit_states",
        "set": "set_unit_cloak"
      },
      "params": {
        "cloak": {
          "type": "bool"
        }
      },
      "lua_runtime": {
        "set": {
          "call": "Spring.SetUnitCloak",
          "args": [
            "fixture.unitID",
            "value.cloak",
            false
          ]
        },
        "call": "Spring.GetUnitStates",
        "args": [
          "fixture.unitID"
        ],
        "returns": [
          {
            "field": "cloak",
            "index": 1,
            "path": [
              "cloak"
            ]
          }
        ]
      }
    },
    {
      "id": "unit_direction_after_set",
      "context": "synced_gadget",
      "kind": "setter_getter",
      "requires": [
        "unit"
      ],
      "lua": {
        "set": [
          "Spring.SetUnitDirection"
        ],
        "get": [
          "Spring.GetUnitDirection"
        ]
      },
      "native": {
        "set": [
          "UnitControl.set_unit_direction"
        ],
        "get": [
          "UnitsInfo.get_unit_vectors"
        ]
      },
      "compare": {
        "mode": "fields",
        "epsilon": 0.05,
        "fields": [
          "frontX",
          "frontY",
          "frontZ",
          "upX",
          "upY",
          "upZ",
          "rightX",
          "rightY",
          "rightZ"
        ]
      },
      "report": {
        "lua_setter": "`Spring.SetUnitDirection`",
        "native_setter": "`UnitControl.set_unit_direction`",
        "lua_getter": "`Spring.GetUnitDirection`",
        "native_getter": "`UnitsInfo.get_unit_vectors`",
        "fields": "`frontX`, `frontY`, `frontZ`, `upX`, `upY`, `upZ`, `rightX`, `rightY`, `rightZ`"
      },
      "rust": {
        "check": "check_unit_vectors",
        "set": "set_unit_direction"
      },
      "params": {
        "orientation": {
          "type": "float3",
          "generator": "unit_orientation",
          "expands_to": [
            "frontX",
            "frontY",
            "frontZ",
            "rightX",
            "rightY",
            "rightZ"
          ]
        }
      },
      "lua_runtime": {
        "set": {
          "call": "Spring.SetUnitDirection",
          "args": [
            "fixture.unitID",
            "value.frontX",
            "value.frontY",
            "value.frontZ",
            "value.rightX",
            "value.rightY",
            "value.rightZ"
          ]
        },
        "call": "Spring.GetUnitDirection",
        "args": [
          "fixture.unitID"
        ],
        "returns": [
          "frontX",
          "frontY",
          "frontZ",
          "rightX",
          "rightY",
          "rightZ",
          "upX",
          "upY",
          "upZ"
        ]
      }
    },
    {
      "id": "get_team_units_counts",
      "context": "synced_gadget",
      "kind": "readonly",
      "requires": [
        "unit"
      ],
      "lua": {
        "set": [],
        "get": [
          "Spring.GetTeamUnitsCounts"
        ]
      },
      "native": {
        "set": [],
        "get": [
          "UnitsQuery.get_team_units_counts"
        ]
      },
      "compare": {
        "mode": "fields",
        "epsilon": 0.05,
        "fields": [
          "counts"
        ]
      },
      "report": {
        "lua_setter": "n/a",
        "native_setter": "n/a",
        "lua_getter": "`Spring.GetTeamUnitsCounts`",
        "native_getter": "`UnitsQuery.get_team_units_counts`",
        "fields": "`counts`"
      },
      "rust": {
        "check": "check_units_query_counts",
        "set": "set_noop"
      },
      "params": {
        "teamID": {
          "type": "i32",
          "fixture": "teamID"
        }
      },
      "lua_runtime": {
        "call": "Spring.GetTeamUnitsCounts",
        "args": [
          "fixture.teamID"
        ],
        "returns": [
          {
            "field": "counts",
            "transform": "unit_def_counts"
          }
        ]
      }
    },
    {
      "id": "unit_add_damage",
      "context": "synced_gadget",
      "kind": "setter_getter",
      "requires": [
        "unit"
      ],
      "lua": {
        "set": [
          "Spring.SetUnitHealth",
          "Spring.AddUnitDamage"
        ],
        "get": [
          "Spring.GetUnitHealth"
        ]
      },
      "native": {
        "set": [
          "UnitControl.set_unit_health",
          "UnitControl.add_unit_damage"
        ],
        "get": [
          "UnitsInfo.get_unit_health"
        ]
      },
      "compare": {
        "mode": "fields",
        "epsilon": 0.05,
        "fields": [
          "health"
        ]
      },
      "report": {
        "lua_setter": "`Spring.SetUnitHealth`, `Spring.AddUnitDamage`",
        "native_setter": "`UnitControl.set_unit_health`, `UnitControl.add_unit_damage`",
        "lua_getter": "`Spring.GetUnitHealth`",
        "native_getter": "`UnitsInfo.get_unit_health`",
        "fields": "`health`"
      },
      "rust": {
        "check": "check_unit_health",
        "set": "add_unit_damage"
      },
      "params": {
        "baseline": {
          "type": "f32",
          "range": [
            700,
            900
          ]
        },
        "damage": {
          "type": "f32",
          "range": [
            20,
            80
          ]
        }
      },
      "lua_runtime": {
        "set": [
          {
            "call": "Spring.SetUnitHealth",
            "args": [
              "fixture.unitID",
              {
                "health": "value.baseline",
                "capture": 0,
                "paralyze": 0,
                "build": 1
              }
            ]
          },
          {
            "call": "Spring.AddUnitDamage",
            "args": [
              "fixture.unitID",
              "value.damage",
              0,
              -1,
              -1,
              0,
              0,
              0
            ]
          }
        ],
        "call": "Spring.GetUnitHealth",
        "args": [
          "fixture.unitID"
        ],
        "returns": [
          "health"
        ]
      }
    },
