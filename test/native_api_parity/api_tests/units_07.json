        "native_setter": "`UnitControl.set_unit_direction`",
        "lua_getter": "`Spring.GetUnitDirection`",
        "native_getter": "`UnitsInfo.get_unit_vectors`",
        "fields": "`frontX`, `frontY`, `frontZ`, `upX`, `upY`, `upZ`, `rightX`, `rightY`, `rightZ`"
