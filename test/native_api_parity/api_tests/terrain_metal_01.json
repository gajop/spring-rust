          "height"
        ]
      },
      "report": {
        "lua_setter": "n/a",
        "native_setter": "n/a",
        "lua_getter": "`Spring.GetGroundOrigHeight`",
        "native_getter": "`terrain().get_ground_orig_height`",
        "fields": "`height`"
      },
      "rust": {
        "check": "check_ground_orig_height",
        "set": "set_noop"
      },
      "params": {
        "point": {
          "type": "float2",
          "generator": "map_point",
          "expands_to": [
            "x",
            "z"
          ]
        }
      },
      "lua_runtime": {
        "call": "Spring.GetGroundOrigHeight",
        "args": ["value.x", "value.z"],
        "returns": ["height"]
      }
    },
