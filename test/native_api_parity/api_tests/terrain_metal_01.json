{
  "version": 1,
  "tests": [
    {
      "id": "ground_height",
      "context": "synced_gadget",
      "kind": "setter_getter",
      "requires": [
        "ground_point"
      ],
      "lua": {
        "set": [
          "Spring.SetHeightMapFunc",
          "Spring.SetHeightMap"
        ],
        "get": [
          "Spring.GetGroundHeight"
        ]
      },
      "native": {
        "set": [
          "TerrainControl.set_height_map"
        ],
        "get": [
          "terrain().get_ground_height"
        ]
      },
      "compare": {
        "mode": "fields",
        "epsilon": 0.05,
        "fields": [
          "height"
        ]
      },
      "report": {
        "lua_setter": "`Spring.SetHeightMapFunc` + `Spring.SetHeightMap`",
        "native_setter": "`TerrainControl.set_height_map`",
        "lua_getter": "`Spring.GetGroundHeight`",
        "native_getter": "`terrain().get_ground_height`",
        "fields": "`height`"
      },
      "rust": {
        "check": "check_ground_height",
        "set": "set_ground_height"
      },
      "params": {
        "point": {
          "type": "float2",
          "generator": "map_point",
          "expands_to": [
            "x",
            "z"
          ]
        },
        "height": {
          "type": "f32",
          "generator": "raised_ground_height"
        },
        "terraform": {
          "type": "f32",
          "range": [
            0,
            1
          ]
        }
      }
    },
    {
