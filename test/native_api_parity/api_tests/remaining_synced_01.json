{
  "version": 1,
  "tests": [
    {
      "id": "add_height_map",
      "context": "synced_gadget",
      "kind": "setter_getter",
      "requires": [],
      "lua": {"set": ["Spring.SetHeightMapFunc", "Spring.AddHeightMap"], "get": ["Spring.GetGroundHeight"]},
      "native": {"set": ["TerrainControl.set_height_map_func", "TerrainControl.add_height_map"], "get": ["Terrain.get_ground_height"]},
      "compare": {"mode": "fields", "epsilon": 0.05, "fields": ["height"]},
      "rust": {"check": "check_remaining_synced", "set": "set_remaining_synced"},
      "params": {
        "x": {"type": "f32", "fixed": 1600},
        "z": {"type": "f32", "fixed": 1600},
        "delta": {"type": "f32", "fixed": 2}
      },
      "wasm_sequence": [
        {"call": "TerrainControl.set_height_map_func", "args": [1, 0], "bind": "registered"},
        {"call": "Terrain.get_ground_height", "args": ["value.x", "value.z"], "bind": "height"}
      ],
      "wasm_callback": {"mode": "add_height_map", "call": "TerrainControl.add_height_map", "args": ["value.x", "value.z", "value.delta"], "team": 0},
      "wasm_returns": [{"field": "height", "from": "height"}]
    },
