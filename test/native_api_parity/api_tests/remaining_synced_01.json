    {
      "id": "add_team_resource_excess_stats",
      "context": "synced_gadget",
      "kind": "setter_getter",
      "requires": [],
      "lua": {"set": ["Spring.AddTeamResourceExcessStats"], "get": ["Spring.GetTeamResourceStats"]},
      "native": {"set": ["TeamControl.add_team_resource_excess_stats"], "get": ["Teams.get_team_resource_stats"]},
      "compare": {"mode": "fields", "epsilon": 0.05, "fields": ["used", "produced", "excessed", "received", "sent"]},
      "rust": {"check": "check_remaining_synced", "set": "set_remaining_synced"},
      "params": {
        "teamID": {"type": "i32", "fixture": "teamID"},
        "resource": {"type": "enum", "values": ["metal", "energy"]},
        "amount": {"type": "f32", "fixed": 3}
      },
      "lua_runtime": {
        "set": {"call": "Spring.AddTeamResourceExcessStats", "args": ["value.teamID", "value.resource", "value.amount"]},
        "call": "Spring.GetTeamResourceStats",
        "args": ["value.teamID", "value.resource"],
        "returns": ["used", "produced", "excessed", "received", "sent"]
      }
    },
    {
      "id": "share_team_resource",
      "context": "synced_gadget",
      "kind": "setter_getter",
      "requires": [],
      "lua": {"set": ["Spring.SetTeamResource", "Spring.ShareTeamResource"], "get": ["Spring.GetTeamResources"]},
      "native": {"set": ["TeamControl.set_team_resource", "TeamControl.share_team_resource"], "get": ["Teams.get_team_resources"]},
      "compare": {"mode": "fields", "epsilon": 0.05, "fields": ["currentLevel", "storage", "share"]},
      "rust": {"check": "check_team_resources", "set": "set_remaining_synced"},
      "params": {
        "teamID": {"type": "i32", "fixed": 0},
        "targetTeamID": {"type": "i32", "fixed": 0},
        "resource": {"type": "enum", "values": ["metal", "energy"]},
        "baseline": {"type": "f32", "fixed": 100},
        "amount": {"type": "f32", "fixed": 3}
      },
      "lua_runtime": {
        "set": [
          {"call": "Spring.SetTeamResource", "args": ["value.teamID", "value.resource", "value.baseline"]},
          {"call": "Spring.ShareTeamResource", "args": ["value.teamID", "value.targetTeamID", "value.resource", "value.amount"]}
        ],
        "call": "Spring.GetTeamResources",
        "args": ["value.teamID", "value.resource"],
        "returns": ["currentLevel", "storage", "pull", "income", "expense", "share"]
      },
      "wasm_sequence": [
        {"call": "TeamControl.set_team_resource", "args": ["value.teamID", "value.resource", "value.baseline"], "bind": "set", "require_true": true},
        {"call": "TeamControl.share_team_resource", "args": ["value.teamID", "value.targetTeamID", "value.resource", "value.amount"], "bind": "shared", "require_true": true},
        {"call": "Teams.get_team_resources", "args": ["value.teamID", "value.resource"], "bind": "resources"}
      ],
      "wasm_returns": [
        {"field": "currentLevel", "from": "resources", "path": ["currentLevel"]},
        {"field": "storage", "from": "resources", "path": ["storage"]},
        {"field": "share", "from": "resources", "path": ["share"]}
      ]
    },
    {
      "id": "set_ally",
      "context": "synced_gadget",
      "kind": "setter_getter",
      "requires": [],
      "lua": {"set": ["Spring.SetAlly"], "get": ["Spring.AreTeamsAllied"]},
      "native": {"set": ["TeamControl.set_ally"], "get": ["Teams.are_teams_allied"]},
      "compare": {"mode": "fields", "fields": ["allied"]},
      "rust": {"check": "check_teams_bool", "set": "set_remaining_synced"},
      "params": {
        "firstAllyTeamID": {"type": "i32", "fixed": 0},
        "secondAllyTeamID": {"type": "i32", "fixed": 0},
        "allied": {"type": "bool", "fixed": true},
        "teamID1": {"type": "i32", "fixed": 0},
        "teamID2": {"type": "i32", "fixed": 0}
      },
      "lua_runtime": {
        "set": {"call": "Spring.SetAlly", "args": ["value.firstAllyTeamID", "value.secondAllyTeamID", "value.allied"]},
        "call": "Spring.AreTeamsAllied",
        "args": ["value.teamID1", "value.teamID2"],
        "returns": ["allied"]
      }
    },
