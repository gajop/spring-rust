      ],
      "wasm_callback": {"mode": "add_original_height_map", "call": "TerrainControl.add_original_height_map", "args": ["value.x", "value.z", "value.delta"], "team": 0},
      "wasm_returns": [{"field": "height", "from": "height"}]
    },
