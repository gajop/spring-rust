      "id": "unit_add_impulse",
      "context": "synced_gadget", "kind": "readonly", "requires": ["unit"],
      "lua": {"set": [], "get": ["Spring.AddUnitImpulse"]},
      "native": {"set": [], "get": ["UnitControl.add_unit_impulse"]},
      "compare": {"mode": "fields", "fields": ["returnCount"]},
      "rust": {"check": "check_unit_control_call", "set": "set_noop"},
      "params": {
        "impulse": {"type": "float3", "generator": "unit_velocity", "expands_to": ["x", "y", "z"]},
        "decayRate": {"type": "f32", "range": [0, 1]}
      },
      "lua_runtime": {"call": "Spring.AddUnitImpulse", "args": ["fixture.unitID", "value.x", "value.y", "value.z", "value.decayRate"], "returns": [{"field": "returnCount", "transform": "return_count"}]}
