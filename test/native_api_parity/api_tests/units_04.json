        "epsilon": 0.05,
        "fields": [
          "value",
          "listed"
        ]
      },
      "report": {
        "lua_setter": "`Spring.SetUnitRulesParam`",
        "native_setter": "`RulesParams.set_unit_rules_param`",
        "lua_getter": "`Spring.GetUnitRulesParam`, `Spring.GetUnitRulesParams`",
        "native_getter": "`RulesParams.get_unit_rules_param`, `RulesParams.get_unit_rules_params`",
        "fields": "`value`, `listed`"
      },
      "rust": {
        "check": "check_rules_param",
        "set": "set_rules_param"
      },
      "params": {
        "scope": {
          "type": "string",
          "fixed": "unit"
        },
        "unitID": {
          "type": "i32",
          "fixture": "unitID"
        },
        "paramName": {
          "type": "string",
          "fixed": "native_api_parity_unit_rules_param"
        },
        "value": {
          "type": "f32",
          "range": [
            10,
            900
          ]
        }
      }
