{
  "version": 1,
  "tests": [
    {
      "id": "get_units_in_sphere",
      "context": "synced_gadget",
      "kind": "readonly",
      "requires": [
        "unit"
      ],
      "lua": {
        "set": [],
        "get": [
          "Spring.GetUnitsInSphere"
        ]
      },
      "native": {
        "set": [],
        "get": [
          "UnitsQuery.get_units_in_sphere"
        ]
      },
      "compare": {
        "mode": "fields",
        "epsilon": 0.05,
        "fields": [
          "unitIDs"
        ]
      },
      "report": {
        "lua_setter": "n/a",
        "native_setter": "n/a",
        "lua_getter": "`Spring.GetUnitsInSphere`",
        "native_getter": "`UnitsQuery.get_units_in_sphere`",
        "fields": "`unitIDs`"
      },
      "rust": {
        "check": "check_units_query_set",
        "set": "set_noop"
      },
      "params": {
        "x": {
          "type": "f32",
          "fixed": 1024
        },
        "y": {
          "type": "f32",
          "fixed": 96
        },
        "z": {
          "type": "f32",
          "fixed": 1024
        },
        "radius": {
          "type": "f32",
          "fixed": 99999
        },
        "allegiance": {
          "type": "i32",
          "fixed": -1
        }
      },
      "lua_runtime": {
        "call": "Spring.GetUnitsInSphere",
        "args": [
          "value.x",
          "value.y",
          "value.z",
          "value.radius",
          "value.allegiance"
        ],
        "returns": [
          "unitIDs"
        ]
      },
      "order_insensitive_fields": [
        "unitIDs"
      ]
    },
