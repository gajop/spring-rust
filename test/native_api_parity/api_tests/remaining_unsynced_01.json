      "native": {"set": ["UnsyncedCtrl.set_unit_palette_index"], "get": ["UnsyncedRead.get_unit_palette_index"]},
      "compare": {"mode": "fields", "fields": ["hasCustomColor", "customIndex"]},
      "report": {"lua_setter": "`Spring.SetUnitPaletteIndex`", "native_setter": "`UnsyncedCtrl.set_unit_palette_index`", "lua_getter": "`Spring.GetUnitPaletteIndex`", "native_getter": "`UnsyncedRead.get_unit_palette_index`", "fields": "palette presence/index"},
      "rust": {"check": "check_unsynced_render_data", "set": "set_unsynced_read_value"},
      "params": {"customIndex": {"type": "i32", "fixed": 4}},
      "lua_runtime": {"set": {"call": "Spring.SetUnitPaletteIndex", "args": ["fixture.unitID", "value.customIndex"]}, "call": "Spring.GetUnitPaletteIndex", "args": ["fixture.unitID"], "returns": [{"field": "hasCustomColor", "transform": "truthy"}, {"field": "customIndex", "transform": "nil_to_minus_one"}]}
    },
