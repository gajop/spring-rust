{
  "version": 1,
  "tests": [
    {
      "id": "custom_palette_color",
      "context": "unsynced_gadget",
      "kind": "setter_getter",
      "requires": [],
      "lua": {"set": ["Spring.SetCustomPaletteColor"], "get": ["Spring.GetCustomPaletteColor"]},
      "native": {"set": ["UnsyncedCtrl.set_custom_palette_color"], "get": ["UnsyncedRead.get_custom_palette_color"]},
      "compare": {"mode": "fields", "epsilon": 0.05, "fields": ["r", "g", "b"]},
      "report": {"lua_setter": "`Spring.SetCustomPaletteColor`", "native_setter": "`UnsyncedCtrl.set_custom_palette_color`", "lua_getter": "`Spring.GetCustomPaletteColor`", "native_getter": "`UnsyncedRead.get_custom_palette_color`", "fields": "`r`, `g`, `b`"},
      "rust": {"check": "check_unsynced_render_data", "set": "set_unsynced_read_value"},
      "params": {"index": {"type": "i32", "fixed": 4}, "r": {"type": "f32", "fixed": 0.2}, "g": {"type": "f32", "fixed": 0.4}, "b": {"type": "f32", "fixed": 0.8}},
      "lua_runtime": {"set": {"call": "Spring.SetCustomPaletteColor", "args": ["value.index", "value.r", "value.g", "value.b"]}, "call": "Spring.GetCustomPaletteColor", "args": ["value.index"], "returns": ["r", "g", "b"]}
    },
    {
      "id": "unit_palette_index",
