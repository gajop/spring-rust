      "context": "unsynced_gadget",
      "kind": "readonly",
      "requires": ["unit"],
      "lua": {"set": [], "get": ["Spring.GetUnitSelectionVolumeData"]},
      "native": {"set": [], "get": ["UnitRendering.get_unit_selection_volume_data"]},
