    {
      "id": "get_feature_separation",
      "context": "synced_gadget",
      "kind": "readonly",
      "requires": [
        "feature"
      ],
      "lua": {
        "set": [],
        "get": [
          "Spring.GetFeatureSeparation"
        ]
      },
      "native": {
        "set": [],
        "get": [
          "Features.get_feature_separation"
        ]
      },
      "compare": {
        "mode": "fields",
        "epsilon": 0.05,
        "fields": [
          "separation"
        ]
      },
      "report": {
        "lua_setter": "n/a",
        "native_setter": "n/a",
        "lua_getter": "`Spring.GetFeatureSeparation`",
        "native_getter": "`Features.get_feature_separation`",
        "fields": "`separation`"
      },
      "rust": {
        "check": "check_feature_separation",
        "set": "set_noop"
      },
      "params": {
        "featureID1": {
          "type": "i32",
          "fixture": "featureID"
        },
        "featureID2": {
          "type": "i32",
          "fixture": "featureID"
        },
        "positional": {
          "type": "bool",
          "fixed": false
        }
      },
      "lua_runtime": {
        "call": "Spring.GetFeatureSeparation",
        "args": [
          "fixture.featureID",
          "fixture.featureID",
          "value.positional"
        ],
        "returns": [
          "separation"
        ]
      }
    },
