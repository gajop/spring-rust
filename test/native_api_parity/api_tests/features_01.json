{
  "version": 1,
  "tests": [
    {
      "id": "feature_health",
      "context": "synced_gadget",
      "kind": "setter_getter",
      "requires": [
        "feature"
      ],
      "lua": {
        "set": [
          "Spring.SetFeatureHealth"
        ],
        "get": [
          "Spring.GetFeatureHealth"
        ]
      },
      "native": {
        "set": [
          "FeatureControl.set_feature_health"
        ],
        "get": [
          "features().get_feature_health"
        ]
      },
      "compare": {
        "mode": "fields",
        "epsilon": 0.05,
        "fields": [
          "health"
        ]
      },
      "report": {
        "lua_setter": "`Spring.SetFeatureHealth`",
        "native_setter": "`FeatureControl.set_feature_health`",
        "lua_getter": "`Spring.GetFeatureHealth`",
        "native_getter": "`features().get_feature_health`",
        "fields": "`health`"
      },
      "rust": {
        "check": "check_feature_health",
        "set": "set_feature_health"
      },
      "params": {
        "health": {
          "type": "f32",
          "range": [
            100,
            950
          ]
        },
        "checkDestruction": {
          "type": "bool",
          "fixed": false
        }
      }
    },
    {
      "id": "feature_max_health",
      "context": "synced_gadget",
      "kind": "setter_getter",
      "requires": [
        "feature"
      ],
      "lua": {
        "set": [
          "Spring.SetFeatureMaxHealth",
          "Spring.SetFeatureHealth"
        ],
        "get": [
          "Spring.GetFeatureHealth"
        ]
      },
      "native": {
        "set": [
          "FeatureControl.set_feature_max_health",
          "FeatureControl.set_feature_health"
        ],
        "get": [
          "features().get_feature_health"
        ]
      },
      "compare": {
        "mode": "fields",
        "epsilon": 0.05,
        "fields": [
          "maxHealth",
          "health"
        ]
      },
      "report": {
        "lua_setter": "`Spring.SetFeatureMaxHealth` + `Spring.SetFeatureHealth`",
        "native_setter": "`FeatureControl.set_feature_max_health` + `FeatureControl.set_feature_health`",
        "lua_getter": "`Spring.GetFeatureHealth`",
        "native_getter": "`features().get_feature_health`",
        "fields": "`maxHealth` via clamped `health`"
      },
      "rust": {
        "check": "check_feature_health",
        "set": "set_feature_max_health"
      },
      "params": {
        "maxHealth": {
          "type": "f32",
          "range": [
            150,
            900
          ]
        }
      }
    },
