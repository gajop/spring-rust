{
  "version": 1,
  "tests": [
    {
      "id": "add_unit_icon",
      "context": "unsynced_gadget",
      "kind": "readonly",
      "requires_rendering": true,
      "requires": [],
      "lua": {"set": [], "get": ["Spring.AddUnitIcon"]},
      "native": {"set": [], "get": ["Icons.add_unit_icon"]},
      "compare": {"mode": "fields", "fields": ["added"]},
      "params": {
        "iconName": {"type": "string", "fixed": "native_api_parity_icon"},
        "texFile": {"type": "string", "fixed": "bitmaps/icons/frame.png"},
        "size": {"type": "f32", "fixed": 1.0},
        "distance": {"type": "f32", "fixed": 1.0},
        "radiusAdjust": {"type": "bool", "fixed": false},
        "u0": {"type": "f32", "fixed": 0.0},
        "v0": {"type": "f32", "fixed": 0.0},
        "u1": {"type": "f32", "fixed": 1.0},
        "v1": {"type": "f32", "fixed": 1.0}
      },
      "lua_runtime": {
        "call": "Spring.AddUnitIcon",
        "args": ["value.iconName", "value.texFile", "value.size", "value.distance", "value.radiusAdjust", "value.u0", "value.v0", "value.u1", "value.v1"],
        "returns": ["added"]
      },
      "rust": {"check": "check_render_control", "set": "set_noop"}
    },
    {
      "id": "free_unit_icon",
      "context": "unsynced_gadget",
