        "args": ["value.iconName"],
        "returns": ["freed"]
      },
      "rust": {"check": "check_render_control", "set": "set_noop"}
    },
    {
      "id": "set_unit_icon",
      "context": "unsynced_gadget",
      "kind": "setter_getter",
      "requires_rendering": true,
      "requires": ["unit"],
      "lua": {"set": ["Spring.SetUnitIcon"], "get": ["Spring.GetUnitIcon"]},
      "native": {"set": ["UnsyncedCtrl.set_unit_icon"], "get": ["UnitRendering.get_unit_icon"]},
      "compare": {"mode": "fields", "fields": ["iconName"]},
      "params": {"iconName": {"type": "string", "fixed": "default"}},
      "lua_runtime": {
        "set": {"call": "Spring.SetUnitIcon", "args": ["fixture.unitID", "value.iconName"]},
        "call": "Spring.GetUnitIcon",
        "args": ["fixture.unitID"],
        "returns": ["iconName"]
      },
      "rust": {"check": "check_unsynced_render_data", "set": "set_render_control"}
    },
    {
