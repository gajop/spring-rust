        "fields": "`xMin`, `zMin`, `xMax`, `zMax`"
      },
      "rust": {
        "check": "check_game_ally_team_start_box",
        "set": "set_ally_team_start_box"
      },
      "params": {
        "allyTeamID": {
          "type": "i32",
          "fixture": "allyTeamID"
        },
        "xMin": {
          "type": "f32",
          "range": [
            200,
            500
          ]
        },
        "zMin": {
          "type": "f32",
          "range": [
            200,
            500
          ]
        },
        "xMax": {
          "type": "f32",
          "range": [
            1200,
            1600
          ]
        },
        "zMax": {
          "type": "f32",
          "range": [
            1200,
            1600
          ]
        }
      },
      "lua_runtime": {
        "set": {
          "call": "Spring.SetAllyTeamStartBox",
          "args": [
            "fixture.allyTeamID",
            "value.xMin",
            "value.zMin",
            "value.xMax",
            "value.zMax"
          ]
        },
        "call": "Spring.GetAllyTeamStartBox",
        "args": [
          "fixture.allyTeamID"
        ],
        "returns": [
          "xMin",
          "zMin",
          "xMax",
          "zMax"
        ]
      }
    },
