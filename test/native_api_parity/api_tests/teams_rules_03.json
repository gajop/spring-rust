      },
      "compare": {
        "mode": "fields",
        "epsilon": 0.05,
        "fields": [
          "xMin",
          "zMin",
          "xMax",
          "zMax"
        ]
      },
      "report": {
        "lua_setter": "`Spring.SetAllyTeamStartBox`",
        "native_setter": "`TeamControl.set_ally_team_start_box`",
        "lua_getter": "`Spring.GetAllyTeamStartBox`",
