    {
      "id": "ally_team_start_box",
      "context": "synced_gadget",
      "kind": "setter_getter",
      "requires": [],
      "lua": {
        "set": [
          "Spring.SetAllyTeamStartBox"
        ],
        "get": [
          "Spring.GetAllyTeamStartBox"
        ]
      },
      "native": {
        "set": [
          "TeamControl.set_ally_team_start_box"
        ],
        "get": [
          "Game.get_ally_team_start_box"
