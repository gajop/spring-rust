{
  "version": 1,
  "tests": [
    {
      "id": "get_global_los",
      "context": "synced_gadget",
      "kind": "readonly",
      "requires": [],
      "lua": {
        "set": [],
        "get": [
          "Spring.GetGlobalLos"
        ]
      },
      "native": {
        "set": [],
        "get": [
          "Game.get_global_los"
        ]
      },
      "compare": {
        "mode": "fields",
        "epsilon": 0.05,
        "fields": [
          "enabled"
        ]
      },
      "report": {
        "lua_setter": "n/a",
        "native_setter": "n/a",
        "lua_getter": "`Spring.GetGlobalLos`",
        "native_getter": "`Game.get_global_los`",
        "fields": "`enabled`"
      },
      "rust": {
        "check": "check_game_global_los",
        "set": "set_noop"
      },
      "params": {
        "allyTeamID": {
          "type": "i32",
          "fixture": "allyTeamID"
        }
      },
      "lua_runtime": {
        "call": "Spring.GetGlobalLos",
        "args": [
          "fixture.allyTeamID"
        ],
        "returns": [
          "enabled"
        ]
      }
    },
