    {
      "id": "get_unit_feature_separation",
      "context": "synced_gadget",
      "kind": "readonly",
      "requires": [
        "unit",
        "feature"
      ],
      "lua": {
        "set": [],
        "get": [
          "Spring.GetUnitFeatureSeparation"
        ]
      },
      "native": {
        "set": [],
        "get": [
          "UnitControl.get_unit_feature_separation"
        ]
      },
      "compare": {
        "mode": "fields",
        "epsilon": 0.05,
        "fields": [
          "separation"
        ]
      },
      "report": {
        "lua_setter": "n/a",
        "native_setter": "n/a",
        "lua_getter": "`Spring.GetUnitFeatureSeparation`",
        "native_getter": "`UnitControl.get_unit_feature_separation`",
        "fields": "`separation`"
      },
      "rust": {
        "check": "check_unit_feature_separation",
        "set": "set_noop"
      },
      "params": {
        "featureID": {
          "type": "i32",
          "fixture": "featureID"
        },
        "surfaceDist": {
          "type": "bool"
        }
      },
      "lua_runtime": {
        "call": "Spring.GetUnitFeatureSeparation",
        "args": [
          "fixture.unitID",
          "fixture.featureID",
          "value.surfaceDist"
        ],
        "returns": [
          "separation"
        ]
      }
    },
