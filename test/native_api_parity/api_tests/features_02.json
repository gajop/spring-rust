{
  "version": 1,
  "tests": [
    {
      "id": "feature_position",
      "context": "synced_gadget",
      "kind": "setter_getter",
      "requires": [
        "feature"
      ],
      "lua": {
        "set": [
          "Spring.SetFeaturePosition"
        ],
        "get": [
          "Spring.GetFeaturePosition"
        ]
      },
      "native": {
        "set": [
          "FeatureControl.set_feature_position"
        ],
        "get": [
          "features().get_feature_position"
        ]
      },
      "compare": {
        "mode": "fields",
        "epsilon": 0.05,
        "fields": [
          "x",
          "y",
          "z"
        ]
      },
      "report": {
        "lua_setter": "`Spring.SetFeaturePosition`",
        "native_setter": "`FeatureControl.set_feature_position`",
        "lua_getter": "`Spring.GetFeaturePosition`",
        "native_getter": "`features().get_feature_position`",
        "fields": "`x`, `y`, `z`"
      },
      "rust": {
        "check": "check_feature_position",
        "set": "set_feature_position"
      },
      "params": {
        "position": {
          "type": "float3",
          "generator": "map_position",
          "expands_to": [
            "x",
            "y",
            "z"
          ]
        },
        "snapToGround": {
          "type": "bool",
          "fixed": false,
          "optional_cases": [
            "omit",
            "false",
            "true"
          ]
        }
      }
    },
