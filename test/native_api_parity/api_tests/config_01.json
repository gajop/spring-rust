    {
      "id": "get_config_int",
      "context": "unsynced_gadget",
      "kind": "readonly",
      "requires": [],
      "lua": {"set": [], "get": ["Spring.GetConfigInt"]},
      "native": {"set": [], "get": ["Config.get_config_int"]},
      "compare": {"mode": "fields", "epsilon": 0.05, "fields": ["value", "exists"]},
      "report": {"lua_setter": "n/a", "native_setter": "n/a", "lua_getter": "`Spring.GetConfigInt`", "native_getter": "`Config.get_config_int`", "fields": "`value`, `exists`"},
      "rust": {"check": "check_config_value", "set": "set_noop"},
      "params": {
        "key": {"type": "string", "fixed": "native_api_parity_missing_int"},
        "defaultValue": {"type": "i32", "range": [100, 200]},
        "hasDefault": {"type": "bool", "fixed": true}
      },
      "lua_runtime": {
        "call": "Spring.GetConfigInt",
        "args": ["value.key", "value.defaultValue"],
        "returns": ["value", {"field": "exists", "index": 1, "transform": "truthy"}]
      }
    },
