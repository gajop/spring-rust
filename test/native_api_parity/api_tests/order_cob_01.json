      "id": "get_cobscript_id_non_cob",
      "context": "synced_gadget",
      "kind": "readonly",
      "requires": ["unit"],
      "lua": {"set": [], "get": ["Spring.GetCOBScriptID"]},
      "native": {"set": [], "get": ["CobScript.get_cobscript_id"]},
      "compare": {"mode": "fields", "fields": ["funcID"]},
      "rust": {"check": "check_cob_script", "set": "set_noop"},
      "params": {"funcName": {"type": "string", "fixed": "NativeApiParityMissingCobFunction"}},
      "lua_runtime": {
        "call": "Spring.GetCOBScriptID",
        "args": ["fixture.unitID", "value.funcName"],
        "returns": [{"field": "funcID", "transform": "nil_to_minus_one"}]
      }
