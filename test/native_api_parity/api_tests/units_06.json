        "lua_getter": "`Spring.GetUnitVectors`",
        "native_getter": "`UnitsInfo.get_unit_vectors`",
        "fields": "`frontX`, `frontY`, `frontZ`, `upX`, `upY`, `upZ`, `rightX`, `rightY`, `rightZ`"
      },
      "rust": {
        "check": "check_unit_vectors",
        "set": "set_noop"
      },
      "params": {},
      "lua_runtime": {
        "call": "Spring.GetUnitVectors",
        "args": [
          "fixture.unitID"
        ],
        "returns": [
          {
            "field": "frontX",
            "index": 1,
            "path": [
              1
            ]
          },
          {
            "field": "frontY",
            "index": 1,
            "path": [
              2
            ]
          },
          {
            "field": "frontZ",
            "index": 1,
            "path": [
              3
            ]
          },
          {
            "field": "upX",
            "index": 2,
            "path": [
              1
            ]
          },
          {
            "field": "upY",
            "index": 2,
            "path": [
              2
            ]
          },
          {
            "field": "upZ",
            "index": 2,
            "path": [
              3
            ]
          },
          {
            "field": "rightX",
            "index": 3,
            "path": [
              1
            ]
          },
          {
            "field": "rightY",
            "index": 3,
            "path": [
              2
            ]
          },
          {
            "field": "rightZ",
            "index": 3,
            "path": [
              3
            ]
          }
        ]
      }
    },
    {
      "id": "unit_collision_volume_data",
      "context": "synced_gadget",
      "kind": "setter_getter",
      "requires": [
        "unit"
      ],
      "lua": {
        "set": [
          "Spring.SetUnitCollisionVolumeData"
        ],
        "get": [
          "Spring.GetUnitCollisionVolumeData"
        ]
      },
      "native": {
        "set": [
          "UnitControl.set_unit_collision_volume_data"
        ],
        "get": [
          "UnitsInfo.get_unit_collision_volume_data"
        ]
      },
      "compare": {
        "mode": "fields",
        "epsilon": 0.05,
        "fields": [
          "scaleX",
          "scaleY",
          "scaleZ",
          "offsetX",
          "offsetY",
          "offsetZ",
          "volumeType",
          "testType",
          "primaryAxis",
          "disabled"
        ]
      },
      "report": {
        "lua_setter": "`Spring.SetUnitCollisionVolumeData`",
        "native_setter": "`UnitControl.set_unit_collision_volume_data`",
        "lua_getter": "`Spring.GetUnitCollisionVolumeData`",
        "native_getter": "`UnitsInfo.get_unit_collision_volume_data`",
        "fields": "`scaleX`, `scaleY`, `scaleZ`, `offsetX`, `offsetY`, `offsetZ`, `volumeType`, `testType`, `primaryAxis`, `disabled`"
      },
      "rust": {
        "check": "check_unit_collision_volume_data",
        "set": "set_unit_collision_volume_data"
      },
      "wasm_mutating": true,
      "params": {
        "scaleX": {
          "type": "f32",
          "range": [
            8,
            72
          ]
        },
        "scaleY": {
          "type": "f32",
          "range": [
            8,
            72
          ]
        },
        "scaleZ": {
          "type": "f32",
          "range": [
            8,
            72
          ]
        },
        "offsetX": {
          "type": "f32",
          "range": [
            -12,
            12
          ]
        },
        "offsetY": {
          "type": "f32",
          "range": [
            -12,
            12
          ]
        },
        "offsetZ": {
          "type": "f32",
          "range": [
            -12,
            12
          ]
        },
        "volumeType": {
          "type": "enum",
          "values": [
            0,
            1,
            2,
            3
          ]
        },
        "testType": {
          "type": "enum",
          "values": [
            0,
            1
          ]
        },
        "primaryAxis": {
          "type": "enum",
          "values": [
            0,
            1,
            2
          ]
        }
      },
      "lua_runtime": {
        "set": {
          "call": "Spring.SetUnitCollisionVolumeData",
          "args": [
            "fixture.unitID",
            "value.scaleX",
            "value.scaleY",
            "value.scaleZ",
            "value.offsetX",
            "value.offsetY",
            "value.offsetZ",
            "value.volumeType",
            "value.testType",
            "value.primaryAxis"
          ],
          "wasm_args": [
            "fixture.unitID",
            {"x": "value.scaleX", "y": "value.scaleY", "z": "value.scaleZ"},
            {"x": "value.offsetX", "y": "value.offsetY", "z": "value.offsetZ"},
            "value.volumeType",
            "value.testType",
            "value.primaryAxis"
          ]
        },
        "call": "Spring.GetUnitCollisionVolumeData",
        "args": [
          "fixture.unitID"
        ],
        "returns": [
          "scaleX",
          "scaleY",
          "scaleZ",
          "offsetX",
          "offsetY",
          "offsetZ",
          "volumeType",
          "testType",
          "primaryAxis",
          "disabled"
        ]
      }
    },
