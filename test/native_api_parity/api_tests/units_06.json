{
  "version": 1,
  "tests": [
    {
      "id": "unit_add_experience",
      "context": "synced_gadget",
      "kind": "setter_getter",
      "requires": [
        "unit"
      ],
      "lua": {
        "set": [
          "Spring.SetUnitExperience",
          "Spring.AddUnitExperience"
        ],
        "get": [
          "Spring.GetUnitExperience"
        ]
      },
      "native": {
        "set": [
          "UnitControl.set_unit_experience",
          "UnitControl.add_unit_experience"
        ],
        "get": [
          "UnitsInfo.get_unit_experience"
        ]
      },
      "compare": {
        "mode": "fields",
        "epsilon": 0.05,
        "fields": [
          "experience"
        ]
      },
      "report": {
        "lua_setter": "`Spring.SetUnitExperience`, `Spring.AddUnitExperience`",
        "native_setter": "`UnitControl.set_unit_experience`, `UnitControl.add_unit_experience`",
        "lua_getter": "`Spring.GetUnitExperience`",
        "native_getter": "`UnitsInfo.get_unit_experience`",
        "fields": "`experience`"
      },
      "rust": {
        "check": "check_unit_experience",
        "set": "add_unit_experience"
      },
      "params": {
        "baseline": {
          "type": "f32",
          "range": [
            0,
            2
          ]
        },
        "deltaExperience": {
          "type": "f32",
          "range": [
            0,
            1
          ]
        }
      },
      "lua_runtime": {
        "set": [
          {
            "call": "Spring.SetUnitExperience",
            "args": [
              "fixture.unitID",
              "value.baseline"
            ]
          },
          {
            "call": "Spring.AddUnitExperience",
            "args": [
              "fixture.unitID",
              "value.deltaExperience"
            ]
          }
        ],
        "call": "Spring.GetUnitExperience",
        "args": [
          "fixture.unitID"
        ],
        "returns": [
          "experience"
        ]
      }
    },
    {
      "id": "get_unit_vectors",
