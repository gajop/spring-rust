{
  "version": 1,
  "tests": [
    {
      "id": "unit_health",
      "context": "synced_gadget",
      "kind": "setter_getter",
      "requires": [
        "unit"
      ],
      "lua": {
        "set": [
          "Spring.SetUnitHealth"
        ],
        "get": [
          "Spring.GetUnitHealth"
        ]
      },
      "native": {
        "set": [
          "UnitControl.set_unit_health"
        ],
        "get": [
          "units_info().get_unit_health"
        ]
      },
      "compare": {
        "mode": "fields",
        "epsilon": 0.05,
        "fields": [
          "health",
          "maxHealth",
          "paralyzeDamage",
          "captureProgress",
          "buildProgress"
        ]
      },
      "report": {
        "lua_setter": "`Spring.SetUnitHealth`",
        "native_setter": "`UnitControl.set_unit_health`",
        "lua_getter": "`Spring.GetUnitHealth`",
        "native_getter": "`units_info().get_unit_health`",
        "fields": "`health`, `maxHealth`, `paralyzeDamage`, `captureProgress`, `buildProgress`"
      },
      "rust": {
        "check": "check_unit_health",
        "set": "set_unit_health"
      },
      "wasm_mutating": true,
      "params": {
        "health": {
          "type": "f32",
          "range": [
            100,
            900
          ]
        },
        "paralyzeDamage": {
          "type": "f32",
          "range": [
            0,
            30
          ]
        },
        "captureProgress": {
          "type": "f32",
          "range": [
            0,
            0.3
          ]
        },
        "buildProgress": {
          "type": "f32",
          "range": [
            0.4,
            1
          ]
        }
      },
      "lua_runtime": {
        "set": {
          "call": "Spring.SetUnitHealth",
          "args": [
            "fixture.unitID",
            {
              "health": "value.health",
              "paralyze": "value.paralyzeDamage",
              "capture": "value.captureProgress",
              "build": "value.buildProgress"
            }
          ],
          "wasm_args": [
            "fixture.unitID",
            {
              "health": "value.health",
              "capture": "value.captureProgress",
              "paralyze": "value.paralyzeDamage",
              "build": "value.buildProgress",
              "useAmounts": true
            }
          ]
        },
        "call": "Spring.GetUnitHealth",
        "args": ["fixture.unitID"],
        "returns": [
          "health",
          "maxHealth",
          "paralyzeDamage",
          "captureProgress",
          "buildProgress"
        ]
      }
    },
