    {
      "id": "ping",
      "context": "unsynced_gadget",
      "kind": "readonly",
      "requires_rendering": true,
      "lua": {"set": [], "get": ["Spring.Ping"]},
      "native": {"set": [], "get": ["SystemControl.ping"]},
      "compare": {"mode": "fields", "fields": ["returnCount"]},
      "rust": {"check": "check_system_control_value", "set": "set_noop"},
      "params": {"tag": {"type": "i32", "fixed": 17}},
      "lua_runtime": {"call": "Spring.Ping", "args": ["value.tag"], "returns": [{"field": "returnCount", "transform": "return_count"}]}
    },
