      "id": "create_unit_cleanup",
      "context": "synced_gadget",
      "kind": "readonly",
      "requires": ["unit", "ground_point"],
      "lua": {"set": [], "get": ["Spring.CreateUnit", "Spring.DestroyUnit"]},
      "native": {"set": [], "get": ["UnitControl.create_unit", "UnitControl.destroy_unit"]},
      "compare": {"mode": "fields", "fields": ["created"]},
      "report": {"lua_getter": "`Spring.CreateUnit`, `Spring.DestroyUnit`", "native_getter": "`UnitControl.create_unit`, `UnitControl.destroy_unit`", "fields": "temporary unit creation and cleanup"},
      "rust": {"check": "check_object_lifecycle", "set": "set_noop"},
      "params": {}
    },
