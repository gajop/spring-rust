      "native": {"set": [], "get": ["Vfs.file_exists"]},
      "compare": {"mode": "fields", "fields": ["exists"]},
      "report": {"lua_setter": "n/a", "native_setter": "n/a", "lua_getter": "`VFS.FileExists`", "native_getter": "`Vfs.file_exists`", "fields": "`exists`"},
      "rust": {"check": "check_vfs_value", "set": "set_noop"},
      "params": {"path": {"type": "string", "fixed": "LuaRules/Gadgets/native_api_parity.lua"}},
      "lua_runtime": {"call": "VFS.FileExists", "args": ["value.path"], "returns": ["exists"]}
