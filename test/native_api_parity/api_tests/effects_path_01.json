    },
    {
      "id": "path_node_costs",
      "context": "synced_gadget",
      "kind": "readonly",
      "requires": [],
      "lua": {"set": [], "get": ["Spring.InitPathNodeCostsArray", "Spring.FreePathNodeCostsArray", "Spring.SetPathNodeCosts", "Spring.GetPathNodeCosts", "Spring.SetPathNodeCost", "Spring.GetPathNodeCost"]},
      "native": {"set": [], "get": ["PathFinder.get_path_node_costs", "PathFinder.init_path_node_costs_array", "PathFinder.free_path_node_costs_array", "PathFinder.set_path_node_costs", "PathFinder.set_path_node_cost", "PathFinder.get_path_node_cost"]},
      "compare": {"mode": "fields", "epsilon": 0.05, "fields": ["init", "setCost", "active", "costCount", "costValue", "activeCost", "free"]},
      "rust": {"check": "check_effects_path_value", "set": "set_noop"},
      "params": {
        "overlayIndex": {"type": "i32", "fixed": 7},
        "sizeX": {"type": "i32", "fixed": 2},
        "sizeZ": {"type": "i32", "fixed": 2},
        "costIndex": {"type": "i32", "fixed": 0},
        "nodeX": {"type": "i32", "fixed": 0},
        "nodeZ": {"type": "i32", "fixed": 0},
        "cost": {"type": "f32", "fixed": 17.25}
      },
      "lua_runtime": {
        "sequence": [
          {"call": "Spring.InitPathNodeCostsArray", "args": ["value.overlayIndex", "value.sizeX", "value.sizeZ"], "bind": "init"},
          {"call": "Spring.SetPathNodeCost", "args": ["value.overlayIndex", "value.costIndex", "value.cost"], "bind": "setCost"},
          {"call": "Spring.SetPathNodeCosts", "args": ["value.overlayIndex"], "bind": "active"},
          {"call": "Spring.GetPathNodeCosts", "args": ["value.overlayIndex"], "bind": "costs"},
          {"call": "Spring.GetPathNodeCost", "args": ["value.nodeX", "value.nodeZ"], "bind": "activeCost"},
          {"call": "Spring.FreePathNodeCostsArray", "args": ["value.overlayIndex"], "bind": "free"}
        ],
        "returns": [
          {"field": "init", "from": "init"},
          {"field": "setCost", "from": "setCost"},
          {"field": "active", "from": "active"},
          {"field": "costCount", "from": "costs", "transform": "length"},
          {"field": "costValue", "from": "costs", "transform": "index", "index": 0},
          {"field": "activeCost", "from": "activeCost"},
          {"field": "free", "from": "free"}
        ]
      },
      "wasm_sequence": [
        {"call": "PathFinder.init_path_node_costs_array", "args": ["value.overlayIndex", "value.sizeX", "value.sizeZ"], "bind": "init", "require_true": true},
        {"call": "PathFinder.set_path_node_cost", "args": ["value.overlayIndex", "value.costIndex", "value.cost"], "bind": "setCost", "require_true": true},
        {"call": "PathFinder.set_path_node_costs", "args": ["value.overlayIndex"], "bind": "active", "require_true": true},
        {"call": "PathFinder.get_path_node_costs", "args": ["value.overlayIndex"], "bind": "costs"},
        {"call": "PathFinder.get_path_node_cost", "args": ["value.nodeX", "value.nodeZ"], "bind": "activeCost"},
        {"call": "PathFinder.free_path_node_costs_array", "args": ["value.overlayIndex"], "bind": "free", "require_true": true}
      ]
    },
    {
      "id": "request_path",
      "context": "synced_gadget",
      "kind": "readonly",
      "requires": ["unit"],
      "lua": {"set": [], "get": ["Spring.RequestPath"]},
      "native": {"set": [], "get": ["PathFinder.request_path"]},
      "compare": {"mode": "fields", "fields": ["valid"]},
      "rust": {"check": "check_effects_path_value", "set": "set_noop"},
      "params": {
        "moveDefName": {"type": "string", "fixed": "KBOT1"},
        "startX": {"type": "f32", "fixed": 900},
        "startY": {"type": "f32", "fixed": 96},
        "startZ": {"type": "f32", "fixed": 900},
        "endX": {"type": "f32", "fixed": 1120},
        "endY": {"type": "f32", "fixed": 96},
        "endZ": {"type": "f32", "fixed": 1120},
        "radius": {"type": "f32", "fixed": 8}
      },
      "wasm_args": [
        0,
        "value.moveDefName",
        {"x": "value.startX", "y": "value.startY", "z": "value.startZ"},
        {"x": "value.endX", "y": "value.endY", "z": "value.endZ"},
        "value.radius"
      ],
      "lua_runtime": {
        "call": "Spring.RequestPath",
        "args": [
          "value.moveDefName",
          "value.startX", "value.startY", "value.startZ",
          "value.endX", "value.endY", "value.endZ",
          "value.radius"
        ],
        "returns": [{"field": "valid", "transform": "truthy"}]
      }
    }
  ]
