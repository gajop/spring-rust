    {
      "id": "is_unit_in_los",
      "context": "synced_gadget",
      "kind": "readonly",
      "requires": [
        "unit"
      ],
      "lua": {
        "set": [],
        "get": [
          "Spring.IsUnitInLos"
        ]
      },
      "native": {
        "set": [],
        "get": [
          "Los.is_unit_in_los"
        ]
      },
      "compare": {
        "mode": "fields",
        "epsilon": 0.05,
        "fields": [
          "inLos"
        ]
      },
      "report": {
        "lua_setter": "n/a",
        "native_setter": "n/a",
        "lua_getter": "`Spring.IsUnitInLos`",
        "native_getter": "`Los.is_unit_in_los`",
        "fields": "`inLos`"
      },
      "rust": {
        "check": "check_los_bool",
        "set": "set_noop"
      },
      "params": {
        "allyTeamID": {
          "type": "i32",
          "fixture": "allyTeamID"
        }
      },
      "lua_runtime": {
        "call": "Spring.IsUnitInLos",
        "args": [
          "fixture.unitID",
          "fixture.allyTeamID"
        ],
        "returns": [
          "inLos"
        ]
      }
    },
